// ============================================================================
// Co-op menus -- original authorship (not derived from any retail menu file).
// Part of the jedi-outcast-coop mod; ships in zz-coop-ui.pk3.
//
// coopMenu        main menu > CO-OP: host a new game, join (network list or IP),
//                 or start split screen on this PC
// coopIngameMenu  pause menu > CO-OP: host the running game, add player 2
//
// The CO-OP buttons that open them are added to the stock menus by the engine
// (ui/coop_buttons.txt, UI_CoopAddMenuButtons). uiScript verbs: coopNewGame,
// coopSplitScreen, coopHost, coopRefresh, coopJoin, coopConnect (ui_main.cpp);
// the server list is FEEDER_COOP_SERVERS.
// ============================================================================
{
	menuDef
	{
		name					"coopMenu"
		fullScreen				1
		rect					0 0 640 480
		visible					1
		focusColor				1 1 1 1
		descX					320
		descY					420
		descScale				0.7
		descColor				.235 .882 .847 1
		descAlignment			ITEM_ALIGN_CENTER

		onOpen
		{
			setcvar				ui_coopMaxPlayers 2 ;
			uiScript			coopRefresh
		}
		onESC
		{
			close				all ;
			open				mainMenu
		}

		itemDef
		{
			name				background
			style				WINDOW_STYLE_SHADER
			rect				0 0 640 480
			background			"gfx/menus/menu1"
			forecolor			1 1 1 1
			visible				1
			decoration
		}
		itemDef
		{
			name				title
			style				WINDOW_STYLE_EMPTY
			rect				0 30 640 30
			text				"CO-OP"
			font				2
			textscale			1.4
			textalign			ITEM_ALIGN_CENTER
			textalignx			320
			forecolor			0.65 0.65 1 1
			visible				1
			decoration
		}
		itemDef
		{
			name				onlineLabel
			style				WINDOW_STYLE_EMPTY
			rect				40 80 270 20
			text				"ONLINE / YOUR NETWORK"
			font				3
			textscale			0.9
			forecolor			0.8 0.8 1 1
			visible				1
			decoration
		}
		itemDef
		{
			name				maxPlayers
			type				ITEM_TYPE_MULTI
			style				WINDOW_STYLE_EMPTY
			rect				40 108 270 20
			text				"Players:"
			descText			"How many players can join (you included)"
			cvar				"ui_coopMaxPlayers"
			cvarFloatList		{ "2" 2  "3" 3  "4" 4 }
			font				3
			textscale			0.8
			textalign			ITEM_ALIGN_LEFT
			forecolor			0.65 0.65 1 1
			visible				1
		}
		itemDef
		{
			name				difficulty
			type				ITEM_TYPE_MULTI
			style				WINDOW_STYLE_EMPTY
			rect				40 130 270 20
			text				"Difficulty:"
			descText			"Difficulty of the new game"
			cvar				"g_spskill"
			cvarFloatList		{ "Padawan" 0  "Jedi" 1  "Jedi Knight" 2  "Jedi Master" 3 }
			font				3
			textscale			0.8
			textalign			ITEM_ALIGN_LEFT
			forecolor			0.65 0.65 1 1
			visible				1
		}
		itemDef
		{
			name				hostButton_glow
			style				WINDOW_STYLE_SHADER
			rect				40 158 230 24
			background			"gfx/menus/menu_buttonback"
			forecolor			1 1 1 1
			visible				0
			decoration
		}
		itemDef
		{
			name				hostButton
			type				ITEM_TYPE_BUTTON
			style				WINDOW_STYLE_EMPTY
			rect				40 158 230 24
			text				"HOST NEW GAME"
			descText			"Start the campaign; friends join with your IP address"
			font				3
			textscale			0.9
			textalign			ITEM_ALIGN_CENTER
			textstyle			3
			textalignx			115
			forecolor			0.65 0.65 1 1
			visible				1
			mouseEnter
			{
				show			hostButton_glow
			}
			mouseExit
			{
				hide			hostButton_glow
			}
			action
			{
				play			"sound/interface/button1.wav" ;
				uiScript		coopNewGame
			}
		}
		itemDef
		{
			name				hostInfo1
			style				WINDOW_STYLE_EMPTY
			rect				40 188 280 20
			text				"Friends join with your IP address (port 29070)."
			font				2
			textscale			0.6
			forecolor			0.75 0.75 0.75 1
			visible				1
			decoration
		}
		itemDef
		{
			name				hostInfo2
			style				WINDOW_STYLE_EMPTY
			rect				40 204 280 20
			text				"To host a saved game: load it, then Esc > CO-OP."
			font				2
			textscale			0.6
			forecolor			0.75 0.75 0.75 1
			visible				1
			decoration
		}
		itemDef
		{
			name				joinLabel
