			font				3
			textscale			0.9
			forecolor			0.8 0.8 1 1
			visible				1
			decoration
		}
		itemDef
		{
			name				serverList
			type				ITEM_TYPE_LISTBOX
			style				WINDOW_STYLE_EMPTY
			rect				40 260 270 80
			feeder				0x18					// FEEDER_COOP_SERVERS
			elementwidth		270
			elementheight		16
			elementtype			LISTBOX_TEXT
			textscale			0.7
			forecolor			0.8 0.8 1 1
			border				1
			bordercolor			0.5 0.5 0.5 1
			visible				1
			descText			"Games on your network (double-click to join)"
			doubleClick
			{
				uiScript		coopJoin
			}
		}
