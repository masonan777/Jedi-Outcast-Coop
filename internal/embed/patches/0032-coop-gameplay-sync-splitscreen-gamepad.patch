+/*
+-------------------------
+jk2coop round 14 diagnostics: a level-script trace for the host.
+cvar g_coopScriptLog (default 4 = everything; 0 = off) writes every script
+command the host runs, every script started, and every name lookup problem to
+coopscript_host.log in the game's base folder (fs_basepath), restarted each
+time the game is launched. Read by the developer to see exactly where a level
+script stops.
+-------------------------
+*/
+extern qboolean	cg_remoteClient;
+static FILE		*s_coopScriptLogFile = NULL;
+static qboolean	s_coopScriptLogTried = qfalse;
+static cvar_t	*g_coopScriptLog = NULL;
+
+static int G_CoopScriptLogLevel( void )
+{
+	if ( cg_remoteClient )
+	{
+		return 0;	// joiners run no level scripts
+	}
+	if ( !g_coopScriptLog )
+	{
+		g_coopScriptLog = gi.cvar( "g_coopScriptLog", "4", 0 );
+	}
+	return g_coopScriptLog ? g_coopScriptLog->integer : 0;
+}
+
+void G_CoopScriptLogText( const char *text )
+{
+	if ( G_CoopScriptLogLevel() <= 0 )
+	{
+		return;
+	}
+	if ( !s_coopScriptLogFile && !s_coopScriptLogTried )
+	{
+		s_coopScriptLogTried = qtrue;
+		cvar_t *base = gi.cvar( "fs_basepath", "", 0 );
+		if ( base && base->string[0] )
+		{
+			s_coopScriptLogFile = fopen( va( "%s/coopscript_host.log", base->string ), "w" );
+		}
+	}
+	if ( !s_coopScriptLogFile )
+	{
+		return;
+	}
+	const size_t len = strlen( text );
+	fprintf( s_coopScriptLogFile, "%8d %s%s", level.time, text, ( len && text[len - 1] == '\n' ) ? "" : "\n" );
+	fflush( s_coopScriptLogFile );
+}
+
+void G_CoopScriptLog( const char *format, ... )
+{
+	if ( G_CoopScriptLogLevel() <= 0 )
+	{
+		return;
+	}
+	va_list		argptr;
+	char		text[1024];
+	va_start( argptr, format );
+	Q_vsnprintf( text, sizeof( text ), format, argptr );
+	va_end( argptr );
+	G_CoopScriptLogText( text );
+}
