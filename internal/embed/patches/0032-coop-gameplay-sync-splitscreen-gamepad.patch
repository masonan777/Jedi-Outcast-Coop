+		}
+		else if ( kind == COOP_VIEW_PANEL_TURRET )
+		{
+			ok = (qboolean)( ok && ( cg.overrides.active & CG_OVERRIDE_FOV ) && cg.overrides.fov == 50 );
+		}
+		else
+		{
+			ok = (qboolean)( ok && ( cg.overrides.active & CG_OVERRIDE_FOV ) && cg.overrides.fov == ( ( cg.snap->ps.stats[STAT_COOP_VIEWKIND] >> 8 ) & 0xff ) );
