+/*
+jk2coop round 24 (joiner only): level crawl bot, the joiner's half. When the
+launcher sets coop_crawl_log, write what this joiner actually got to that file:
+
+  P2 MAP     map=<name>                  first frame on a new level
+  P2 INGAME  map=<name> frames=<n>       spawned and 60 frames drawn
+  P2 ALIVE   map=<name> frames=<n> t=<s> every 10 s after that
+  P2 SHUTDOWN map=<name> frames=<n>      level unloaded normally
+
+A crash or a drop shows up as the lines simply stopping (plus the launcher
+seeing the process die). The host's half is G_CoopCrawlFrame (g_utils.cpp).
+*/
+static vmCvar_t	s_crawlLogCvar;
+static qboolean	s_crawlRegistered;
+static int		s_crawlFrames;
+static int		s_crawlStage;		// 0 = new level, 1 = MAP logged, 2 = INGAME logged
+static int		s_crawlNextAlive;
+static int		s_crawlStartMs;
+
+static void CG_CoopCrawlLog( const char *format, ... )
+{
+	if ( !s_crawlRegistered )
+	{
+		cgi_Cvar_Register( &s_crawlLogCvar, "coop_crawl_log", "", 0 );
+		s_crawlRegistered = qtrue;
+	}
+	cgi_Cvar_Update( &s_crawlLogCvar );
+	if ( !s_crawlLogCvar.string[0] )
+	{
+		return;
+	}
+	va_list	argptr;
+	char	text[1024];
+	va_start( argptr, format );
+	Q_vsnprintf( text, sizeof( text ), format, argptr );
+	va_end( argptr );
+	FILE *f = fopen( s_crawlLogCvar.string, "a" );
+	if ( f )
+	{
+		fprintf( f, "%s\n", text );
+		fclose( f );
+	}
+}
+
+static const char *CG_CoopCrawlMapName( void )
+{
+	const char *name = cgs.mapname;
+	if ( !Q_stricmpn( name, "maps/", 5 ) )
+	{
+		name += 5;
+	}
+	static char s_name[MAX_QPATH];
+	Q_strncpyz( s_name, name, sizeof( s_name ) );
+	char *dot = strrchr( s_name, '.' );
+	if ( dot )
+	{
+		*dot = 0;
+	}
+	return s_name;
+}
+
+static void CG_CoopCrawlFrame( void )
+{
+	if ( !cg_remoteClient || !cg.snap )
+	{
+		return;
+	}
+	s_crawlFrames++;
+	const int now = cgi_Milliseconds();
+	if ( s_crawlStage == 0 )
+	{
+		s_crawlStage = 1;
+		s_crawlFrames = 1;
+		s_crawlStartMs = now;
+		s_crawlNextAlive = now + 10000;
+		CG_CoopCrawlLog( "P2 MAP map=%s", CG_CoopCrawlMapName() );
+	}
+	if ( s_crawlStage == 1 && s_crawlFrames >= 60 && cg.snap->ps.stats[STAT_HEALTH] > 0 )
+	{
+		s_crawlStage = 2;
+		s_crawlNextAlive = now + 10000;
+		CG_CoopCrawlLog( "P2 INGAME map=%s frames=%d", CG_CoopCrawlMapName(), s_crawlFrames );
+	}
+	if ( s_crawlStage == 2 && now >= s_crawlNextAlive )
+	{
+		s_crawlNextAlive = now + 10000;
+		CG_CoopCrawlLog( "P2 ALIVE map=%s frames=%d t=%d", CG_CoopCrawlMapName(), s_crawlFrames, ( now - s_crawlStartMs ) / 1000 );
+	}
+	if ( s_crawlStage == 1 && now >= s_crawlNextAlive )
+	{// not in yet: say why (for maps where the joiner never gets going)
+		s_crawlNextAlive = now + 10000;
+		CG_CoopCrawlLog( "P2 WAIT map=%s frames=%d t=%d client=%d hp=%d pm=%d in_camera=%d cmdtime=%d servertime=%d",
+			CG_CoopCrawlMapName(), s_crawlFrames, ( now - s_crawlStartMs ) / 1000, cg.snap->ps.clientNum,
+			cg.snap->ps.stats[STAT_HEALTH], cg.snap->ps.pm_type, (int)in_camera, cg.snap->ps.commandTime, cg.snap->serverTime );
+	}
+}
+
+// CG_Shutdown: this level is being unloaded normally
+void CG_CoopCrawlShutdown( void )
+{
+	if ( cg_remoteClient && s_crawlStage )
+	{
+		CG_CoopCrawlLog( "P2 SHUTDOWN map=%s frames=%d", CG_CoopCrawlMapName(), s_crawlFrames );
+	}
+	s_crawlStage = 0;
+	s_crawlFrames = 0;
+}
