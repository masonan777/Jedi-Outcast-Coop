+/*
+======================
+CG_RemoteNPCVoice
+
+jk2coop: on a joiner, give an NPC the same voice the host gave it. The host's
+NPC_ParseParms reads snd/sndcombat/sndextra/sndjedi from the .npc file and
+loads the sounds into the NPC's clientInfo; the joiner never runs that, so its
+NPCs had empty sound tables and never grunted, died or talked. The host now
+sends the four folder names in a configstring (CS_COOP_NPCVOICE + the NPC's
+s.modelindex3, see NPC_stats.cpp G_CoopNPCVoiceIndex); load the same sounds
+here. Cheap to call every frame: it only does work when the voice changes, the
+entity slot is reused, or the client struct was rebuilt.
+======================
+*/
+static int	s_npcVoiceIndex[MAX_GENTITIES];
+static char	s_npcVoiceDirs[MAX_GENTITIES][4][MAX_QPATH];
+static char	*s_npcVoicePtr[MAX_GENTITIES][4];
+
+static void CG_RemoteNPCVoice( centity_t *cent )
+{
+	if ( !cg_remoteClient || !cent )
+	{
+		return;
+	}
+	const int num = cent->currentState.number;
+	if ( num < MAX_CLIENTS || num >= ENTITYNUM_WORLD )
+	{
+		return;
+	}
+	gentity_t *nent = cent->gent;
+	if ( !nent || !nent->client )
+	{
+		return;		// CG_RemoteNPCModel hasn't built this NPC yet
+	}
+	clientInfo_t *ci = &nent->client->clientInfo;
+	const int idx = cent->currentState.modelindex3;
+	if ( idx <= 0 || idx >= COOP_NPC_VOICE_MAX )
+	{
+		return;		// no voice networked (old host, table full, or not an NPC)
+	}
+
+	if ( s_npcVoiceIndex[num] == idx
+		&& ci->customBasicSoundDir == s_npcVoicePtr[num][0]
+		&& ci->customCombatSoundDir == s_npcVoicePtr[num][1]
+		&& ci->customExtraSoundDir == s_npcVoicePtr[num][2]
+		&& ci->customJediSoundDir == s_npcVoicePtr[num][3] )
+	{
+		return;		// already applied to this exact client struct
+	}
+
+	const char *cs = CG_ConfigString( CS_COOP_NPCVOICE + idx );
+	const int prefixLen = (int)strlen( COOP_NPC_VOICE_PREFIX );
+	if ( !cs || Q_stricmpn( cs, COOP_NPC_VOICE_PREFIX, prefixLen ) )
+	{
+		return;		// configstring not here yet; try again next time
+	}
+
+	// parse the four folder names ("-" = none), then the NPC class
+	const char *p = cs + prefixLen;
+	for ( int k = 0; k < 4; k++ )
+	{
+		while ( *p == ' ' )
+		{
+			p++;
+		}
+		int len = 0;
+		while ( p[len] && p[len] != ' ' )
+		{
+			len++;
+		}
+		char *dst = s_npcVoiceDirs[num][k];
+		dst[0] = 0;
+		if ( len > 0 && len < MAX_QPATH && !( len == 1 && p[0] == '-' ) )
+		{
+			Q_strncpyz( dst, p, len + 1 );
+		}
+		s_npcVoicePtr[num][k] = dst[0] ? dst : NULL;
+		p += len;
+	}
+
+	// jk2coop round 13: NPC class (droids are posed differently from people
+	// in CG_G2PlayerAngles); missing on an older host -> left as is
+	while ( *p == ' ' )
+	{
+		p++;
+	}
+	if ( *p >= '0' && *p <= '9' )
+	{
+		const int cls = atoi( p );
+		if ( cls > CLASS_NONE && cls < CLASS_NUM_CLASSES )
+		{
+			nent->client->NPC_class = (class_t)cls;
+		}
+		// jk2coop round 16: then the saber colour from the .npc file
+		while ( *p >= '0' && *p <= '9' )
+		{
+			p++;
+		}
+		while ( *p == ' ' )
+		{
+			p++;
+		}
+		if ( *p >= '0' && *p <= '9' )
+		{
+			nent->client->ps.saberColor = (saber_colors_t)atoi( p );
+		}
+	}
+
+	ci->customBasicSoundDir = s_npcVoicePtr[num][0];
+	ci->customCombatSoundDir = s_npcVoicePtr[num][1];
+	ci->customExtraSoundDir = s_npcVoicePtr[num][2];
+	ci->customJediSoundDir = s_npcVoicePtr[num][3];
+	memset( ci->sounds, 0, sizeof( ci->sounds ) );	// drop a previous occupant's voice
+	CG_RegisterNPCCustomSounds( ci );
+	s_npcVoiceIndex[num] = idx;
+}
