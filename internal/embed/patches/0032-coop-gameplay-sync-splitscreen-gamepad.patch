+		// not their client data, and they aren't in the game yet after a load --
+		// they reconnect and get spawned fresh. Without this, each joiner's old
+		// body stood frozen where it was saved (e.g. still sitting in an
+		// emplaced gun, which then counted as occupied) and was later glued to
+		// the joiner's new body. Remove those leftovers.
+		for ( i = 1; i < MAX_CLIENTS; i++ )
+		{
+			gentity_t *ent = &g_entities[i];
+			if ( !ent->inuse )
+			{
+				continue;
+			}
+			G_CoopReleaseEmplacedGun( ent );
+			if ( ent->ghoul2.IsValid() )
+			{
+				gi.G2API_CleanGhoul2Models( ent->ghoul2 );
+			}
+			ent->playerModel = -1;
+			ent->weaponModel = -1;
+			gi.unlinkentity( ent );
+			ent->s.modelindex = 0;
+			ent->inuse = qfalse;
+			ClearInUse( ent );
+			ent->classname = "disconnected";
+			if ( ent->client )
+			{
+				ent->client->pers.connected = CON_DISCONNECTED;
+			}
+		}
 	}
 }
 
