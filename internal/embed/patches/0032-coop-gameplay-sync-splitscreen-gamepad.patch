+static void CG_CoopTestFrame( void )
+{
+	if ( !s_coopTest.name[0] )
+	{
+		return;
+	}
+	const int	now = cgi_Milliseconds();
+	const char	*t = s_coopTest.name;
+	char		d[512];
+
+	if ( !Q_stricmp( t, "menuclock" ) )
+	{
+		if ( s_coopTest.phase == 2 && now >= s_coopTest.start + 2600 )
+		{
+			s_coopTest.frameA = CG_CoopTestLegsFrame( atoi( s_coopTest.arg[0] ) );
+			s_coopTest.phase = 3;
+		}
+	}
+	if ( now < s_coopTest.due )
+	{
+		return;
+	}
+
+	if ( !Q_stricmp( t, "obj" ) )
+	{
+		char got[MAX_MISSION_OBJ + 1];
+		for ( int i = 0; i < MAX_MISSION_OBJ; i++ )
+		{
+			got[i] = (char)( '0' + ( g_coopObjectives[i].display ? 4 : 0 ) + ( g_coopObjectives[i].status & 3 ) );
+		}
+		got[MAX_MISSION_OBJ] = 0;
+		int bad = -1;
+		for ( int i = 0; i < MAX_MISSION_OBJ && bad < 0; i++ )
+		{
+			if ( got[i] != s_coopTest.arg[0][i] )
+			{
+				bad = i;
+			}
+		}
+		Com_sprintf( d, sizeof( d ), "first_mismatch=%d got=%.8s want=%.8s", bad, got, s_coopTest.arg[0] );
+		CG_CoopTestResult( (qboolean)( bad < 0 ), d );
+	}
+	else if ( !Q_stricmp( t, "cam" ) && !Q_stricmp( s_coopTest.arg[0], "off" ) )
+	{
+		Com_sprintf( d, sizeof( d ), "after: in_camera=%d", (int)in_camera );
+		CG_CoopTestResult( (qboolean)!in_camera, d );
+	}
+	else if ( !Q_stricmp( t, "cam" ) )
+	{
+		vec3_t want = { (float)atof( s_coopTest.arg[0] ), (float)atof( s_coopTest.arg[1] ), (float)atof( s_coopTest.arg[2] ) };
+		const float dist = Distance( want, client_camera.origin );
+		Com_sprintf( d, sizeof( d ), "in_camera=%d camera_off_by=%.0f bars=%.2f", (int)in_camera, dist, client_camera.bar_alpha );
+		CG_CoopTestResult( (qboolean)( in_camera && dist < 32.0f ), d );
+	}
+	else if ( !Q_stricmp( t, "snapview" ) )
+	{
+		vec3_t eye;
+		VectorCopy( cg.snap->ps.origin, eye );
+		eye[2] += cg.snap->ps.viewheight;
+		const float dist = Distance( eye, cg.snap->ps.serverViewOrg );
+		Com_sprintf( d, sizeof( d ), "server_viewpoint_off_by=%.0f (must be our own eyes)", dist );
+		CG_CoopTestResult( (qboolean)( dist < 8.0f ), d );
+	}
+	else if ( !Q_stricmp( t, "camview" ) || !Q_stricmp( t, "npcview" ) || !Q_stricmp( t, "turret" ) )
+	{
+		const int kind = atoi( s_coopTest.arg[0] );
+		const int ent = atoi( s_coopTest.arg[1] );
+		vec3_t at = { (float)atof( s_coopTest.arg[2] ), (float)atof( s_coopTest.arg[3] ), (float)atof( s_coopTest.arg[4] ) };
+		const int ve = cg.snap->ps.viewEntity;
+		const int gotKind = cg.snap->ps.stats[STAT_COOP_VIEWKIND] & 0xff;
