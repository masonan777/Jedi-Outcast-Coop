+// jk2coop: Xbox-style gamepad support (SDL GameController API). When the
+// selected device is a recognised game controller (Xbox, PlayStation, Switch
+// Pro, ... - SDL maps them all to the same Xbox layout) it is read as a
+// gamepad instead of the generic 2002-era joystick path below:
+//   left stick  -> analog movement     (cl_input.cpp CL_GamepadMove)
+//   right stick -> analog look/aim     (cl_input.cpp CL_GamepadMove)
+//   buttons     -> bindable keys JOY1..JOY17 (fixed, driver-independent)
+//   in menus    -> left stick moves the cursor, A clicks, B / Start = Escape
+static SDL_GameController *gamepad = NULL;
+qboolean in_gamepadActive = qfalse;			// read by cl_input.cpp
+static cvar_t *in_gamepad				= NULL;	// 0 = always use the old joystick path
+static cvar_t *in_joystickBackground	= NULL;	// keep reading the pad when the window isn't focused
+static cvar_t *joy_triggerThreshold	= NULL;
+static cvar_t *joy_menuCursorSpeed		= NULL;
+
+// gamepad button -> key. The order of this table is the JOYn numbering
+// players bind against (JOY1 = A ... JOY15 = D-pad right; triggers are JOY16/17).
+static const struct {
+	SDL_GameControllerButton	button;
+	int							key;
+} gamepadButtons[] = {
+	{ SDL_CONTROLLER_BUTTON_A,				A_JOY1 },
+	{ SDL_CONTROLLER_BUTTON_B,				A_JOY2 },
+	{ SDL_CONTROLLER_BUTTON_X,				A_JOY3 },
+	{ SDL_CONTROLLER_BUTTON_Y,				A_JOY4 },
+	{ SDL_CONTROLLER_BUTTON_BACK,			A_JOY5 },
+	{ SDL_CONTROLLER_BUTTON_GUIDE,			A_JOY6 },
