+/*
+=================
+jk2coop round 33 (joiner only): the crosshair trace. A joiner's gi.trace only
+knows the level's brushes, so it hits the wall behind a character and the
+crosshair never identified anyone. Same trace against the level, plus the
+boxes of the characters/doors/turrets in this snapshot (like cgame's own
+prediction trace, but from the networked entity state: our gentity copies
+have no solid size).
+=================
+*/
+void CG_CoopCrosshairTrace( trace_t *tr, const vec3_t start, const vec3_t end, int skipNum, int mask )
+{
+	vec3_t	nullv = { 0, 0, 0 };
+	cgi_CM_BoxTrace( tr, start, end, nullv, nullv, 0, mask );
+	tr->entityNum = ( tr->fraction != 1.0f ) ? ENTITYNUM_WORLD : ENTITYNUM_NONE;
+	for ( int k = 0; k < cg.snap->numEntities; k++ )
+	{
+		const entityState_t *es = &cg.snap->entities[k];
+		if ( es->number == skipNum || es->number >= ENTITYNUM_WORLD || !es->solid )
+		{
+			continue;
+		}
+		centity_t		*cent = &cg_entities[es->number];
+		clipHandle_t	cmodel;
+		vec3_t			angles;
+		if ( es->solid == SOLID_BMODEL )
+		{
+			cmodel = cgi_CM_InlineModel( es->modelindex );
+			VectorCopy( cent->lerpAngles, angles );
+		}
+		else
+		{
+			const int x = ( es->solid & 255 );
+			const int zd = ( ( es->solid >> 8 ) & 255 );
+			const int zu = ( ( es->solid >> 16 ) & 255 ) - 32;
+			vec3_t bmins, bmaxs;
+			bmins[0] = bmins[1] = -x;
+			bmaxs[0] = bmaxs[1] = x;
+			bmins[2] = -zd;
+			bmaxs[2] = zu;
+			cmodel = cgi_CM_TempBoxModel( bmins, bmaxs );
+			VectorClear( angles );
+		}
+		trace_t t;
+		cgi_CM_TransformedBoxTrace( &t, start, end, nullv, nullv, cmodel, mask, cent->lerpOrigin, angles );
+		if ( t.fraction < tr->fraction )
+		{
+			t.entityNum = es->number;
+			*tr = t;
+		}
+	}
+}
