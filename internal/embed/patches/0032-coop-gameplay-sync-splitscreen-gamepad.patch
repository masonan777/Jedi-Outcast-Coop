+/*
+=================
+CL_GamepadMove
+
+jk2coop: an Xbox-style gamepad (shared/sdl/sdl_input.cpp IN_GamepadMove).
+Left stick moves - tilt it a little to walk, push it all the way to run, full
+speed in every direction. Right stick aims, with a response curve so small
+movements are precise and a full push turns fast. Speeds are in degrees per
+second at full tilt and are scaled down by the weapon zoom like the mouse.
+=================
+*/
+extern qboolean in_gamepadActive;
+static cvar_t	*joy_deadzone;
+static cvar_t	*joy_lookDeadzone;
+static cvar_t	*joy_yawSpeed;
+static cvar_t	*joy_pitchSpeed;
+static cvar_t	*joy_lookCurve;
+static cvar_t	*joy_invertY;
+static cvar_t	*joy_walkThreshold;
+
+// map a stick to [0..1] after a radial deadzone; returns the direction in dx/dy
+static float CL_GamepadStick( int rawX, int rawY, float deadzone, float *dx, float *dy )
+{
+	const float	x = rawX / 32767.0f;
+	const float	y = rawY / 32767.0f;
+	const float	mag = sqrtf( x * x + y * y );
+
+	if ( deadzone < 0.0f ) deadzone = 0.0f;
+	if ( deadzone > 0.9f ) deadzone = 0.9f;
+	if ( mag <= deadzone || mag <= 0.0f )
+	{
+		*dx = *dy = 0.0f;
+		return 0.0f;
+	}
+	*dx = x / mag;
+	*dy = y / mag;
+	float amount = ( mag - deadzone ) / ( 1.0f - deadzone );
+	return amount > 1.0f ? 1.0f : amount;
+}
+
+static void CL_GamepadMove( usercmd_t *cmd )
+{
+	float	dx, dy, amount;
+
+	// --- left stick: movement ---
+	amount = CL_GamepadStick( cl.joystickAxis[AXIS_SIDE], cl.joystickAxis[AXIS_FORWARD], joy_deadzone->value, &dx, &dy );
+	if ( amount > 0.0f )
+	{
+		// scale the direction so its larger component is full (127): the
+		// player then moves at full speed diagonally too, like with keys
+		const float biggest = ( fabsf( dx ) > fabsf( dy ) ) ? fabsf( dx ) : fabsf( dy );
+		cmd->rightmove = ClampChar( cmd->rightmove + (int)( dx / biggest * 127.0f ) );
+		cmd->forwardmove = ClampChar( cmd->forwardmove - (int)( dy / biggest * 127.0f ) );	// stick up = negative
+		if ( amount < joy_walkThreshold->value )
+		{
+			cmd->buttons |= BUTTON_WALKING;
+		}
+	}
+
+	// --- right stick: aiming ---
+	amount = CL_GamepadStick( cl.joystickAxis[AXIS_YAW], cl.joystickAxis[AXIS_PITCH], joy_lookDeadzone->value, &dx, &dy );
+	if ( amount > 0.0f )
+	{
+		float curve = joy_lookCurve->value;
+		if ( curve < 1.0f ) curve = 1.0f;
+		if ( curve > 4.0f ) curve = 4.0f;
+		const float strength = powf( amount, curve );
+		float secs = cls.frametime * 0.001f;
+		if ( secs > 0.1f ) secs = 0.1f;	// no huge jump after a hitch
+		const float sens = cl.cgameSensitivity > 0.0f ? cl.cgameSensitivity : 1.0f;
+
+		cl.viewangles[YAW] -= joy_yawSpeed->value * strength * dx * secs * sens;
+		cl.viewangles[PITCH] += joy_pitchSpeed->value * strength * dy * secs * sens * ( joy_invertY->integer ? -1.0f : 1.0f );
+	}
+}
+
