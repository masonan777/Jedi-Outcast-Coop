+	joy_lookDeadzone	= Cvar_Get( "joy_lookDeadzone",	"0.15",	CVAR_ARCHIVE_ND );
+	joy_yawSpeed		= Cvar_Get( "joy_yawSpeed",		"220",	CVAR_ARCHIVE_ND );
+	joy_pitchSpeed		= Cvar_Get( "joy_pitchSpeed",	"160",	CVAR_ARCHIVE_ND );
+	joy_lookCurve		= Cvar_Get( "joy_lookCurve",	"2",	CVAR_ARCHIVE_ND );
+	joy_invertY			= Cvar_Get( "joy_invertY",		"0",	CVAR_ARCHIVE_ND );
+	joy_walkThreshold	= Cvar_Get( "joy_walkThreshold","0.5",	CVAR_ARCHIVE_ND );
