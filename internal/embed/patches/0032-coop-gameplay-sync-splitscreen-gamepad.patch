+// give a co-op player a weapon the way a pickup would (no forced switch)
+extern void WP_SaberInitBladeData( gentity_t *ent );
+void G_CoopGiveWeapon( gentity_t *ent, int wp )
+{
+	if ( !ent || !ent->client || wp <= WP_NONE || wp >= WP_NUM_WEAPONS )
+	{
+		return;
+	}
+	const qboolean hadWeapon = (qboolean)( ( ent->client->ps.stats[STAT_WEAPONS] & ( 1 << wp ) ) != 0 );
+	gitem_t *item = FindItemForWeapon( (weapon_t)wp );
+	if ( item )
+	{
+		RegisterItem( item );
+	}
+	ent->client->ps.stats[STAT_WEAPONS] |= ( 1 << wp );
+	const int ammoIndex = weaponData[wp].ammoIndex;
+	if ( ammoIndex > AMMO_NONE && ammoIndex < AMMO_MAX
+		&& ent->client->ps.ammo[ammoIndex] < ammoData[ammoIndex].max )
+	{
+		ent->client->ps.ammo[ammoIndex] = ammoData[ammoIndex].max;
+	}
+	if ( wp == WP_SABER && !hadWeapon )
+	{
+		WP_SaberInitBladeData( ent );
+	}
+	if ( item && !hadWeapon )
+	{
+		G_AddEvent( ent, EV_ITEM_PICKUP, ( item - bg_itemlist ) );
+	}
+}
+
+// Jedi progression is handed out by each level's start script, which only ever
+// affects the host ("kyle"): Force power levels, saber skill and, at the end of
+// the trial, the lightsaber itself. jk2coop round 15: joiners now get EXACTLY
+// the host's Force powers and levels (was "at least the host's"). Every player
+// spawns with the engine's default Force set (WP_InitForcePowers: jump 2, heal,
+// speed, push, pull, grip, lightning, ...) and only the host's copy is cut back
+// by the level script (kejim_start sets every level to 0), so player 2 could
+// Force-jump on the very first level.
+void G_CoopSyncProgression( void )
+{
+	gentity_t *host = &g_entities[0];
+
+	if ( !host->client || !G_CoopHasJoiners() )
+	{
+		return;
+	}
+	for ( int i = 1; i < MAX_CLIENTS; i++ )
+	{
+		if ( !G_CoopPlayerActive( i ) )
+		{
+			continue;
+		}
+		gentity_t *ent = &g_entities[i];
+		if ( !ent->client || ent->health <= 0 )
+		{
+			continue;
+		}
+		for ( int fp = 0; fp < NUM_FORCE_POWERS; fp++ )
+		{
+			ent->client->ps.forcePowerLevel[fp] = host->client->ps.forcePowerLevel[fp];
+		}
+		ent->client->ps.forcePowersKnown = host->client->ps.forcePowersKnown;
+		ent->client->ps.forcePowerMax = host->client->ps.forcePowerMax;
+		if ( ent->client->ps.forcePower > ent->client->ps.forcePowerMax )
+		{
+			ent->client->ps.forcePower = ent->client->ps.forcePowerMax;
+		}
+		if ( ( host->client->ps.stats[STAT_WEAPONS] & ( 1 << WP_SABER ) )
+			&& !( ent->client->ps.stats[STAT_WEAPONS] & ( 1 << WP_SABER ) ) )
+		{
+			G_CoopGiveWeapon( ent, WP_SABER );
+		}
+	}
+}
