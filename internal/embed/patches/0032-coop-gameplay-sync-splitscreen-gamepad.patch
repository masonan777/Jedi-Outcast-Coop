+//---------------------------------------------------------
+// jk2coop: where a JOINER's shot leaves from.
+//
+// CalcMuzzlePoint (below) almost always returns the muzzle point cached in
+// ent->client->renderInfo.muzzlePoint. For the host that cache is written by
+// the host's own first-person viewmodel (CG_AddViewWeapon, cg_weapons.cpp), so
+// host shots leave the visible gun barrel. For a joiner the same cache is
+// written by the HOST's cgame drawing the joiner's third-person body
+// (cg_players.cpp), i.e. the rifle held in front of the joiner's chest -- not
+// what the joiner sees. From the joiner's own first-person camera that point
+// sits straight below the eyes, so every bolt appeared to come out of the
+// middle-bottom of the screen and race toward the crosshair (the "vertical red
+// beam" in the screenshots). The host watching in third person saw it right.
+//
+// Fix (same approach JACoop takes for its joiners): build the joiner's shot
+// start from its own view -- eyes (origin + viewheight + lean) plus a per-weapon
+// forward/right/up offset along its view angles -- and store it in the cache,
+// so CalcMuzzlePoint and every weapon's fire function use it unchanged. The
+// offsets match a first-person viewmodel's barrel closely enough that the bolt
+// visibly leaves the joiner's gun. Host shots (slot 0) are untouched.
+//---------------------------------------------------------
+static qboolean G_CoopJoinerMuzzleOffset( int weapon, vec3_t ofs )
+{//	forward, right, up (from the eyes)
+	switch ( weapon )
+	{
+	case WP_BRYAR_PISTOL:
+	case WP_BLASTER_PISTOL:
+	case WP_BLASTER:
+	case WP_DISRUPTOR:
+	case WP_DEMP2:
+	case WP_FLECHETTE:
+		VectorSet( ofs, 12, 6, -6 );
+		return qtrue;
+	case WP_BOWCASTER:
+		VectorSet( ofs, 12, 2, -6 );
+		return qtrue;
+	case WP_REPEATER:
+		VectorSet( ofs, 12, 4.5f, -6 );
+		return qtrue;
+	case WP_ROCKET_LAUNCHER:
+		VectorSet( ofs, 12, 8, -4 );
+		return qtrue;
+	case WP_THERMAL:
+	case WP_DET_PACK:
+		VectorSet( ofs, 12, 0, -4 );
+		return qtrue;
+	case WP_TRIP_MINE:
+		VectorSet( ofs, 12, 0, -10 );
+		return qtrue;
+	default:
+		return qfalse;	// saber, melee, stun baton, vehicles/emplaced: keep the stock path
+	}
+}
+
+static void G_CoopJoinerShotStart( gentity_t *ent )
+{
+	vec3_t	ofs, fwd, right, up, eye, muzzle;
+
+	if ( !G_IsCoopPlayer( ent ) || ent->s.number == 0 )
+	{
+		return;	// NPCs and the host keep the original behaviour
+	}
+	if ( ent->client->ps.vehicleModel || ( ent->client->ps.eFlags & EF_LOCKED_TO_WEAPON ) )
+	{
+		return;
+	}
+	if ( !G_CoopJoinerMuzzleOffset( ent->s.weapon, ofs ) )
+	{
+		return;
+	}
+	AngleVectors( ent->client->ps.viewangles, fwd, right, up );
+	VectorCopy( ent->client->ps.origin, eye );
+	eye[2] += ent->client->ps.viewheight;
+	if ( ent->client->ps.leanofs )
+	{
+		VectorMA( eye, (float)ent->client->ps.leanofs, right, eye );
+	}
+	VectorMA( eye, ofs[0], fwd, muzzle );
+	VectorMA( muzzle, ofs[1], right, muzzle );
+	VectorMA( muzzle, ofs[2], up, muzzle );
+
+	VectorCopy( muzzle, ent->client->renderInfo.muzzlePoint );
+	VectorCopy( fwd, ent->client->renderInfo.muzzleDir );
+	ent->client->renderInfo.mPCalcTime = level.time;	// CalcMuzzlePoint takes it as is
+}
