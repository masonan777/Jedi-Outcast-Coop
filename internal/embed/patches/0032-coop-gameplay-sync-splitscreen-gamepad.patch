+/*
+==============
+jk2coop round 33 (joiner): the co-op feature test bot's checks. The host's
+bot (g_utils.cpp GT_RunTest) changes something and sends
+"cooptest <test> <ms> <expected...>"; <ms> later we look at our own state
+and log "P2 GT map=.. test=.. PASS|FAIL <what we saw>" to coop_crawl_log.
+==============
+*/
+extern int	g_coopChargeGlowCount;
+extern void	CG_CoopCrosshairTrace( trace_t *tr, const vec3_t start, const vec3_t end, int skipNum, int mask );
+static struct
+{
+	char	name[32];
+	char	arg[8][96];
+	int		argc;
+	int		start;
+	int		due;
+	int		phase;
+	float	frameA;
+	qboolean haveA;
+	int		chargeBase;
+	char	thirdPerson[8];
+} s_coopTest;
+
+void CG_CoopTest_f( void )
+{
+	if ( !cg_remoteClient )
+	{
+		return;
+	}
+	memset( &s_coopTest, 0, sizeof( s_coopTest ) );
+	Q_strncpyz( s_coopTest.name, CG_Argv( 1 ), sizeof( s_coopTest.name ) );
+	s_coopTest.start = cgi_Milliseconds();
+	s_coopTest.due = s_coopTest.start + atoi( CG_Argv( 2 ) );
+	for ( int i = 0; i < 8 && i + 3 < cgi_Argc(); i++ )
+	{
+		Q_strncpyz( s_coopTest.arg[i], CG_Argv( i + 3 ), sizeof( s_coopTest.arg[i] ) );
+		s_coopTest.argc = i + 1;
+	}
+	if ( !Q_stricmp( s_coopTest.name, "charge" ) )
+	{// the glow is on the first-person gun
+		s_coopTest.chargeBase = g_coopChargeGlowCount;
+		Q_strncpyz( s_coopTest.thirdPerson, va( "%d", cg_thirdPerson.integer ), sizeof( s_coopTest.thirdPerson ) );
+		cgi_Cvar_Set( "cg_thirdperson", "0" );
+	}
+	else if ( !Q_stricmp( s_coopTest.name, "menuclock" ) )
+	{// open the pause menu (full screen) and close it again. Our own frames stop
+	 // while a full-screen menu is up, so the closing has to come from the
+	 // engine's command buffer ("wait" counts engine frames), not from here.
+		cgi_SendConsoleCommand( "togglemenu; wait 60; togglemenu\n" );
+		s_coopTest.phase = 2;
+	}
+}
+
+static void CG_CoopTestResult( qboolean pass, const char *detail )
+{
+	CG_CoopCrawlLog( "P2 GT map=%s test=%s %s %s", CG_CoopCrawlMapName(), s_coopTest.name, pass ? "PASS" : "FAIL", detail );
+	s_coopTest.name[0] = 0;
+}
