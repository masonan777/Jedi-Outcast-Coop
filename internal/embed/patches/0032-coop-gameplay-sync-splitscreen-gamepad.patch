+/*
+jk2coop round 12: the three "client side shortcut hacks" above (CG_Chunks,
+CG_MiscModelExplosion, and CG_DoGlass further down) are cgame functions that
+the game code calls DIRECTLY -- legal in single player because game and cgame
+are one DLL, but it means the debris, the explosion and the shattering glass
+are drawn only in the HOST's process and never sent over the network. On a
+joiner, a crate, door or window just vanished. Each call now also sends an
+EV_COOP_FX temp entity carrying the same arguments; only remote clients act on
+it (cg_event.cpp), since the host has already drawn it.
+*/
+extern qboolean cg_remoteClient;
+
+static gentity_t *G_CoopFxEvent( const vec3_t org, int fxType )
+{
+	if ( cg_remoteClient || !G_CoopHasJoiners() )
+	{
+		return NULL;
+	}
+	vec3_t o;
+	VectorCopy( org, o );
+	gentity_t *te = G_TempEntity( o, EV_COOP_FX );
+	te->s.eventParm = fxType;
+	te->svFlags |= SVF_BROADCAST;
+	return te;
+}
+
+static void G_CoopChunks( int owner, vec3_t origin, const vec3_t normal, const vec3_t mins, const vec3_t maxs,
+							float speed, int numChunks, material_t chunkType, int customChunk, float baseScale )
+{
+	CG_Chunks( owner, origin, normal, mins, maxs, speed, numChunks, chunkType, customChunk, baseScale );
+	gentity_t *te = G_CoopFxEvent( origin, COOP_FX_CHUNKS );
+	if ( te )
+	{
+		VectorCopy( origin, te->s.origin );		// exact (the temp entity origin is snapped)
+		VectorCopy( normal, te->s.origin2 );
+		VectorCopy( mins, te->s.angles );
+		VectorCopy( maxs, te->s.angles2 );
+		te->s.apos.trBase[0] = speed;
+		te->s.apos.trBase[1] = baseScale;
+		te->s.otherEntityNum = ( owner >= 0 && owner < ENTITYNUM_MAX_NORMAL ) ? owner : ENTITYNUM_NONE;
+		te->s.modelindex2 = numChunks < 0 ? 0 : ( numChunks > 255 ? 255 : numChunks );
+		te->s.modelindex3 = chunkType;
+		te->s.frame = customChunk;
+	}
+}
+
+static void G_CoopMiscModelExplosion( vec3_t mins, vec3_t maxs, int size, material_t chunkType )
+{
+	CG_MiscModelExplosion( mins, maxs, size, chunkType );
+	vec3_t mid;
+	VectorAdd( mins, maxs, mid );
+	VectorScale( mid, 0.5f, mid );
+	gentity_t *te = G_CoopFxEvent( mid, COOP_FX_MODELEXP );
+	if ( te )
+	{
+		VectorCopy( mins, te->s.angles );
+		VectorCopy( maxs, te->s.angles2 );
+		te->s.modelindex2 = size;
+		te->s.modelindex3 = chunkType;
+	}
+}
