 =================
 UI_LoadMenus
@@ -3043,6 +3121,8 @@ void UI_LoadMenus(const char *menuFile, qboolean reset)
 	}
 	COM_EndParseSession();
 
+	UI_CoopAddMenuButtons();	// jk2coop: CO-OP buttons on the main and pause menus
+
 	Com_Printf("UI menu load time = %d milli seconds\n", Sys_Milliseconds() - start);
 
 	ui.FS_FreeFile( buffer );	//let go of the buffer
