+static void G_CoopViewKindSync( void )
+{
+	for ( int i = 0; i < MAX_CLIENTS; i++ )
+	{
+		gentity_t *ent = &g_entities[i];
+		if ( !ent->inuse || !ent->client || ent->NPC )
+		{
+			continue;
+		}
+		int kind = COOP_VIEW_NONE;
+		const int ve = ent->client->ps.viewEntity;
+		if ( ve > 0 && ve < ENTITYNUM_WORLD && g_entities[ve].inuse )
+		{
+			gentity_t *v = &g_entities[ve];
+			if ( v->classname && !Q_stricmp( v->classname, "misc_camera" ) )
+			{
+				kind = v->health > 0 ? COOP_VIEW_CAMERA : COOP_VIEW_CAMERA_DEAD;
+			}
+			else if ( v->classname && !Q_stricmp( v->classname, "misc_panel_turret" ) )
+			{
+				kind = COOP_VIEW_PANEL_TURRET;
+			}
+			else if ( v->client && v->NPC )
+			{
+				int fov = (int)v->NPC->stats.hfov;
+				if ( fov > 120 ) fov = 120;
+				if ( fov < 10 ) fov = 10;
+				kind = COOP_VIEW_NPC | ( fov << 8 );
+			}
+			else
+			{
+				kind = COOP_VIEW_OTHER;
+			}
+		}
+		ent->client->ps.stats[STAT_COOP_VIEWKIND] = kind;
+	}
