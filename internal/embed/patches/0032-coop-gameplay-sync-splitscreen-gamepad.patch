+/*
+jk2coop round 12: the three "client side shortcut hacks" above (CG_Chunks,
+CG_MiscModelExplosion, and CG_DoGlass further down) are cgame functions that
+the game code calls DIRECTLY -- legal in single player because game and cgame
+are one DLL, but it means the debris, the explosion and the shattering glass
+are drawn only in the HOST's process and never sent over the network. On a
+joiner, a crate, door or window just vanished. Each call now also sends an
+EV_COOP_FX temp entity carrying the same arguments; only remote clients act on
+it (cg_event.cpp), since the host has already drawn it.
+*/
+extern qboolean cg_remoteClient;
+
+static gentity_t *G_CoopFxEvent( const vec3_t org, int fxType )
+{
+	if ( cg_remoteClient || !G_CoopHasJoiners() )
+	{
+		return NULL;
+	}
+	vec3_t o;
+	VectorCopy( org, o );
+	gentity_t *te = G_TempEntity( o, EV_COOP_FX );
+	te->s.eventParm = fxType;
+	te->svFlags |= SVF_BROADCAST;
+	return te;
+}
