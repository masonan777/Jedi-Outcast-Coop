+/*
+jk2coop round 17 (joiner only): the sound a moving brush's sound set has for
+`stage` (0 start, 1 loop, 2 stop), looked up in THIS process. A mover's
+loopSound / EV_BMODEL_SOUND parameter is the host's private sound handle; here
+it named a different sound, and when that happened to be a voice MP3
+("sound/chars/turret/startup") the joiner was dropped from the game with
+"S_AddLoopSounds(): Cannot use streamed MP3 files here". The host sends the set's
+name instead (G_CoopSoundSetIndex, slot in s.time2). The joiner never spawned
+the map's entities, so its ambient-set list starts empty: add the set and
+re-read the sets file the first time one is needed. 0 = nothing to play.
+*/
+sfxHandle_t CG_CoopBModelSound( int slot, int stage )
+{
+	static char		tried[COOP_NPC_VOICE_MAX][MAX_QPATH];	// set name last loaded per slot (slots change per level)
+	if ( slot <= 0 || slot >= COOP_NPC_VOICE_MAX )
+	{
+		return 0;
+	}
+	const char		*cs = CG_ConfigString( CS_COOP_NPCVOICE + slot );
+	const int		prefixLen = (int)strlen( COOP_BMSET_PREFIX );
+	if ( !cs || Q_stricmpn( cs, COOP_BMSET_PREFIX, prefixLen ) || !cs[prefixLen] )
+	{
+		return 0;
+	}
+	const char		*name = cs + prefixLen;
+	sfxHandle_t		sfx = cgi_AS_GetBModelSound( name, stage );
+	if ( sfx <= 0 && Q_stricmp( tried[slot], name ) )
+	{
+		Q_strncpyz( tried[slot], name, sizeof( tried[slot] ) );
+		cgi_AS_AddPrecacheEntry( name );
+		cgi_AS_ParseSets();
+		sfx = cgi_AS_GetBModelSound( name, stage );
+	}
+	return ( sfx > 0 ) ? sfx : 0;
+}
