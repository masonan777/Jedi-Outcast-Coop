+		VectorCopy( maxs, te->s.angles2 );
+		te->s.apos.trBase[0] = speed;
+		te->s.apos.trBase[1] = baseScale;
+		te->s.otherEntityNum = ( owner >= 0 && owner < ENTITYNUM_MAX_NORMAL ) ? owner : ENTITYNUM_NONE;
+		te->s.modelindex2 = numChunks < 0 ? 0 : ( numChunks > 255 ? 255 : numChunks );
+		te->s.modelindex3 = chunkType;
+		te->s.frame = customChunk;
+	}
+}
