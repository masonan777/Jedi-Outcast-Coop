+/*
+=================
+jk2coop: co-op player helpers (declared in g_local.h)
+=================
+*/
+qboolean G_IsCoopPlayer( const gentity_t *ent )
+{
+	return (qboolean)( ent != NULL
+		&& ent->s.number >= 0 && ent->s.number < MAX_CLIENTS
+		&& ent->client != NULL
+		&& ent->NPC == NULL );
+}
+
+qboolean G_CoopPlayerActive( int clientNum )
+{
+	if ( clientNum < 0 || clientNum >= MAX_CLIENTS || !level.clients )
+	{
+		return qfalse;
+	}
+	const gentity_t *ent = &g_entities[clientNum];
+	return (qboolean)( ent->client != NULL
+		&& ent->client->pers.connected == CON_CONNECTED
+		&& PInUse( clientNum ) );
+}
+
+qboolean G_CoopHasJoiners( void )
+{
+	for ( int i = 1; i < MAX_CLIENTS; i++ )
+	{
+		if ( G_CoopPlayerActive( i ) )
+		{
+			return qtrue;
+		}
+	}
+	return qfalse;
+}
+
+gentity_t *G_CoopNearestPlayer( const vec3_t org, qboolean requireAlive )
+{
+	gentity_t	*best = NULL;
+	float		bestDist = 0.0f;
+
+	for ( int i = 0; i < MAX_CLIENTS; i++ )
+	{
+		if ( !G_CoopPlayerActive( i ) )
+		{
+			continue;
+		}
+		gentity_t *ent = &g_entities[i];
+		if ( requireAlive && ent->health <= 0 )
+		{
+			continue;
+		}
+		const float dist = DistanceSquared( org, ent->currentOrigin );
+		if ( !best || dist < bestDist )
+		{
+			best = ent;
+			bestDist = dist;
+		}
+	}
+	return best ? best : &g_entities[0];
+}
+
+/*
+=================
+jk2coop: round 8 helpers -- things the campaign does to "the player" (the host)
+that every co-op player needs
+=================
+*/
+
+// jk2coop round 17: slot of a mover's ambient sound set name in the shared
+// CS_COOP_NPCVOICE configstring table (0 = none / table full). Moving brushes
+// send their loop and start/stop sounds as the HOST's own sound handles
+// (CAS_GetBModelSound), which mean a different sound -- or a voice MP3 that
+// can't loop -- in another game process; the joiner looks the set up by name.
+int G_CoopSoundSetIndex( const char *soundSet )
+{
+	char	name[MAX_STRING_CHARS];
+	char	s[MAX_STRING_CHARS];
+	int		i;
+
+	if ( !soundSet || !soundSet[0] )
+	{
+		return 0;
+	}
+	Com_sprintf( name, sizeof( name ), COOP_BMSET_PREFIX "%s", soundSet );
+	for ( i = 1; i < COOP_NPC_VOICE_MAX; i++ )
+	{
+		gi.GetConfigstring( CS_COOP_NPCVOICE + i, s, sizeof( s ) );
+		if ( !s[0] )
+		{
+			break;
+		}
+		if ( !Q_stricmp( s, name ) )
+		{
+			return i;
+		}
+	}
+	if ( i >= COOP_NPC_VOICE_MAX )
+	{
+		return 0;
+	}
+	gi.SetConfigstring( CS_COOP_NPCVOICE + i, name );
+	return i;
+}
+
+// a center-screen message meant for whoever did something (picked up a key,
+// used a panel). Non-players (NPCs, scripts) fall back to the host.
+void G_CoopCenterPrint( const gentity_t *who, const char *text )
+{
+	const int clientNum = ( who && G_IsCoopPlayer( who ) ) ? who->s.number : 0;
+	gi.SendServerCommand( clientNum, "%s", text );
+}
+
+// put a joiner at origin without the teleporter's telefrag (G_KillBox)
+static void G_CoopPlaceJoiner( gentity_t *ent, const vec3_t origin, const vec3_t angles )
+{
+	vec3_t	ang;
+
+	G_CoopReleaseEmplacedGun( ent );
+	gi.unlinkentity( ent );
+	VectorCopy( origin, ent->client->ps.origin );
+	ent->client->ps.origin[2] += 1;
+	VectorCopy( ent->client->ps.origin, ent->currentOrigin );
+	VectorClear( ent->client->ps.velocity );
+	ent->client->ps.eFlags ^= EF_TELEPORT_BIT;	// no lerp on the clients
+	VectorCopy( angles, ang );
+	SetClientViewAngle( ent, ang );
+	PlayerStateToEntityState( &ent->client->ps, &ent->s );
+	gi.linkentity( ent );
+}
+
+// a free spot for a joiner next to the host: behind / beside him, reachable in
+// a straight line from him (never through a wall), standing room, floor below
+static qboolean G_CoopFindSpotNear( const gentity_t *host, const gentity_t *ent, vec3_t out )
+{
+	static const float	dists[] = { 64.0f, 96.0f, 128.0f };
+	static const int	order[] = { 4, 3, 5, 2, 6, 1, 7, 0 };	// behind first, in front last
+	trace_t		tr;
+	vec3_t		cand, below;
+	const float	baseYaw = host->client ? host->client->ps.viewangles[YAW] : host->currentAngles[YAW];
+
+	for ( size_t d = 0; d < ARRAY_LEN( dists ); d++ )
+	{
+		for ( size_t k = 0; k < ARRAY_LEN( order ); k++ )
+		{
+			const float yaw = DEG2RAD( baseYaw + order[k] * 45.0f );
+			VectorCopy( host->currentOrigin, cand );
+			cand[0] += cosf( yaw ) * dists[d];
+			cand[1] += sinf( yaw ) * dists[d];
+
+			gi.trace( &tr, host->currentOrigin, ent->mins, ent->maxs, cand, host->s.number, MASK_PLAYERSOLID, G2_NOCOLLIDE, 0 );
+			if ( tr.startsolid || tr.allsolid || tr.fraction < 1.0f )
+			{
+				continue;
+			}
+			VectorCopy( cand, below );
+			below[2] -= 64.0f;
+			gi.trace( &tr, cand, ent->mins, ent->maxs, below, host->s.number, MASK_PLAYERSOLID, G2_NOCOLLIDE, 0 );
+			if ( tr.startsolid || tr.allsolid || tr.fraction >= 1.0f )
+			{
+				continue;	// nothing to stand on (ledge, pit)
+			}
+			VectorCopy( tr.endpos, out );
+			return qtrue;
+		}
+	}
+	return qfalse;
+}
+
+// bring joiners to the host after the campaign moved him somewhere they may not
+// be able to follow (scripted teleport, end of a locked ride). With onlyFar,
+// joiners who are already close and in his line of sight stay where they are.
+void G_CoopBringJoinersToHost( qboolean onlyFar )
+{
+	gentity_t	*host = &g_entities[0];
+	vec3_t		spot;
+
+	if ( !host->client || host->health <= 0 || !G_CoopHasJoiners() )
+	{
+		return;
+	}
+	for ( int i = 1; i < MAX_CLIENTS; i++ )
+	{
+		if ( !G_CoopPlayerActive( i ) )
+		{
+			continue;
+		}
+		gentity_t *ent = &g_entities[i];
+		if ( ent->health <= 0 || !ent->client )
+		{
+			continue;
+		}
+		if ( onlyFar
+			&& DistanceSquared( ent->currentOrigin, host->currentOrigin ) < 768.0f * 768.0f
+			&& gi.inPVS( ent->currentOrigin, host->currentOrigin ) )
+		{
+			continue;
+		}
+		if ( G_CoopFindSpotNear( host, ent, spot ) )
+		{
+			G_CoopPlaceJoiner( ent, spot, host->client->ps.viewangles );
+		}
+	}
+}
+
+// jk2coop round 19: a player who joins a level already in progress spawns at
+// the map's start spot, which the level has often left behind (bespin_streets:
+// the lift the host rode up at the start). Shortly after a joiner spawns, put
+// him next to the host unless he is already close. Set by ClientSpawn.
+int g_coopJoinPlaceTime[MAX_CLIENTS];
+extern bool in_camera;
+
+void G_CoopCheckJoinPlacement( void )
+{
+	gentity_t	*host = &g_entities[0];
+	vec3_t		spot;
+
+	for ( int i = 1; i < MAX_CLIENTS; i++ )
+	{
+		if ( !g_coopJoinPlaceTime[i] || level.time < g_coopJoinPlaceTime[i] )
+		{
+			continue;
+		}
+		if ( in_camera || !host->client || host->health <= 0 )
+		{
+			continue;	// try again when the host is back in control
+		}
+		g_coopJoinPlaceTime[i] = 0;
+		gentity_t *ent = &g_entities[i];
+		if ( !G_CoopPlayerActive( i ) || !ent->client || ent->health <= 0 )
+		{
+			continue;
+		}
+		if ( DistanceSquared( ent->currentOrigin, host->currentOrigin ) < 192.0f * 192.0f )
+		{
+			continue;
+		}
+		if ( G_CoopFindSpotNear( host, ent, spot ) )
+		{
+			G_CoopPlaceJoiner( ent, spot, host->client->ps.viewangles );
+		}
+	}
+}
+
+/*
+=================
+jk2coop round 23: downed / revive
+
+While another player is still standing, a co-op player who takes a fatal hit
+goes DOWN instead of dying: he drops to the floor (knockdown pose held), can
+only look around, takes no damage and enemies ignore him. A partner who holds
+USE next to him for COOP_REVIVE_TIME brings him back with
+COOP_REVIVE_HEALTH_PCT of his max health. If everyone is down at once the game
+is over: they all die for real and the host gets the normal "mission failed"
+screen. Plain single player (no joiners) is unchanged.
+
+The state lives only here (never in a save game), so a save made while someone
+is down can't leave anyone permanently invulnerable or untargetable.
+=================
+*/
+#define COOP_REVIVE_TIME			3000	// ms of holding USE
+#define COOP_REVIVE_RANGE			80.0f	// units between the two players
+#define COOP_REVIVE_HEALTH_PCT		25
+
+typedef struct
+{
+	qboolean	downed;
+	int			progress;	// ms of revive done so far
+	int			reviver;	// client doing it (-1 = nobody)
+} coopDown_t;
+
+static coopDown_t	s_coopDown[MAX_CLIENTS];
+static qboolean		s_coopGameOver;
+static int			s_coopReviveLastTime;
+
+extern void WP_ForcePowerStop( gentity_t *self, forcePowers_t forcePower );
+extern void G_ClearEnemy( gentity_t *self );
+
+qboolean G_CoopIsDowned( const gentity_t *ent )
+{
+	if ( !ent || ent->s.number < 0 || ent->s.number >= MAX_CLIENTS || !G_IsCoopPlayer( ent ) )
+	{
+		return qfalse;
+	}
+	return s_coopDown[ent->s.number].downed;
+}
+
+void G_CoopDownClear( int clientNum )
+{
+	if ( clientNum >= 0 && clientNum < MAX_CLIENTS )
+	{
+		s_coopDown[clientNum].downed = qfalse;
+		s_coopDown[clientNum].progress = 0;
+		s_coopDown[clientNum].reviver = -1;
+		if ( g_entities[clientNum].client )
+		{
+			g_entities[clientNum].client->ps.stats[STAT_COOP_DOWNED] = 0;
+			g_entities[clientNum].client->ps.stats[STAT_COOP_REVIVE] = 0;
+		}
+	}
+}
+
+// new level / loaded game
+void G_CoopDownReset( void )
+{
+	for ( int i = 0; i < MAX_CLIENTS; i++ )
+	{
+		s_coopDown[i].downed = qfalse;
+		s_coopDown[i].progress = 0;
+		s_coopDown[i].reviver = -1;
+	}
+	s_coopGameOver = qfalse;
+	s_coopReviveLastTime = 0;
+}
+
+// a player who is in the game, alive and not downed
+static qboolean G_CoopPlayerUp( int i )
+{
+	return (qboolean)( G_CoopPlayerActive( i ) && g_entities[i].client
+		&& g_entities[i].health > 0 && !s_coopDown[i].downed );
+}
+
+static void G_CoopPlayerName( int clientNum, char *out, int outSize )
+{
+	if ( clientNum == 0 )
+	{
+		Q_strncpyz( out, "Player 1", outSize );
+	}
+	else
+	{
+		Com_sprintf( out, outSize, "Player %d", clientNum + 1 );
+	}
+}
+
+static void G_CoopHoldDownedPose( gentity_t *ent )
+{
+	gclient_t *cl = ent->client;
+	if ( cl->ps.legsAnim != BOTH_KNOCKDOWN1 || cl->ps.torsoAnim != BOTH_KNOCKDOWN1 )
+	{// (a pain anim can take over the torso on the hit that downed him)
+		NPC_SetAnim( ent, SETANIM_BOTH, BOTH_KNOCKDOWN1, SETANIM_FLAG_OVERRIDE|SETANIM_FLAG_HOLD );
+	}
+	// a knockdown ends (getup anim) when its timer runs out; keep it running
+	if ( cl->ps.legsAnimTimer < 500 )
+	{
+		cl->ps.legsAnimTimer = 500;
+	}
+	if ( cl->ps.torsoAnimTimer < 500 )
+	{
+		cl->ps.torsoAnimTimer = 500;
+	}
+}
+
+qboolean G_CoopTryDown( gentity_t *ent, int mod )
+{
+	if ( s_coopGameOver || !G_IsCoopPlayer( ent ) || !G_CoopHasJoiners() )
+	{
+		return qfalse;
+	}
+	const int n = ent->s.number;
+	if ( s_coopDown[n].downed )
+	{
+		return qfalse;
+	}
+	// is anybody else still standing? (nearest one, for falls into pits etc.)
+	gentity_t	*partner = NULL;
+	float		best = 0.0f;
+	for ( int i = 0; i < MAX_CLIENTS; i++ )
+	{
+		if ( i == n || !G_CoopPlayerUp( i ) )
+		{
+			continue;
+		}
+		const float d = DistanceSquared( g_entities[i].currentOrigin, ent->currentOrigin );
+		if ( !partner || d < best )
+		{
+			partner = &g_entities[i];
+			best = d;
+		}
+	}
+	if ( !partner )
+	{
+		return qfalse;	// last one standing: real death, game over as usual
+	}
+
+	gclient_t *cl = ent->client;
+	ent->health = 1;
+	cl->ps.stats[STAT_HEALTH] = 1;
+	s_coopDown[n].downed = qtrue;
+	s_coopDown[n].progress = 0;
+	s_coopDown[n].reviver = -1;
+
+	// killed by the level (pit, crusher, lava, drowning): go down next to the
+	// partner instead of somewhere nobody can reach
+	if ( mod == MOD_FALLING || mod == MOD_TRIGGER_HURT || mod == MOD_CRUSH
+		|| mod == MOD_LAVA || mod == MOD_SLIME || mod == MOD_WATER )
+	{
+		vec3_t spot;
+		if ( G_CoopFindSpotNear( partner, ent, spot ) )
+		{
+			G_CoopPlaceJoiner( ent, spot, cl->ps.viewangles );
+		}
+	}
+
+	// drop everything: Force powers, lit saber, a mounted gun
+	for ( int fp = 0; fp < NUM_FORCE_POWERS; fp++ )
+	{
+		if ( cl->ps.forcePowersActive & ( 1 << fp ) )
+		{
+			WP_ForcePowerStop( ent, (forcePowers_t)fp );
+		}
+	}
+	if ( cl->ps.saberActive && !cl->ps.saberInFlight )
+	{
+		cl->ps.saberActive = qfalse;
+		G_Sound( ent, G_SoundIndex( "sound/weapons/saber/saberoffquick.wav" ) );
+	}
+	if ( cl->ps.eFlags & EF_LOCKED_TO_WEAPON )
+	{
+		G_CoopReleaseEmplacedGun( ent );
+	}
+	G_CoopHoldDownedPose( ent );
+
+	// enemies stop shooting at him
+	for ( int i = MAX_CLIENTS; i < ENTITYNUM_WORLD; i++ )
+	{
+		gentity_t *npc = &g_entities[i];
+		if ( npc->inuse && npc->NPC && npc->enemy == ent )
+		{
+			G_ClearEnemy( npc );
+		}
+	}
+
+	char name[32];
+	G_CoopPlayerName( n, name, sizeof( name ) );
+	gi.SendServerCommand( n, "cp \"You're down!\nHang on - your partner can revive you.\"" );
+	for ( int i = 0; i < MAX_CLIENTS; i++ )
+	{
+		if ( i != n && G_CoopPlayerActive( i ) )
+		{
+			gi.SendServerCommand( i, "cp \"%s is down!\nGo to them and hold USE to revive.\"", name );
+		}
+	}
+	return qtrue;
+}
+
+static void G_CoopRevive( gentity_t *ent, int reviverNum )
+{
+	const int	n = ent->s.number;
+	gclient_t	*cl = ent->client;
+	const int	maxHealth = cl->ps.stats[STAT_MAX_HEALTH] > 0 ? cl->ps.stats[STAT_MAX_HEALTH] : 100;
+	int			health = maxHealth * COOP_REVIVE_HEALTH_PCT / 100;
+
+	if ( health < 1 )
+	{
+		health = 1;
+	}
+	G_CoopDownClear( n );
+	ent->health = health;
+	cl->ps.stats[STAT_HEALTH] = health;
+	// let the knockdown finish: pmove plays the get-up anim on its own
+	cl->ps.legsAnimTimer = 0;
+	cl->ps.torsoAnimTimer = 0;
+
+	char name[32], reviverName[32];
+	G_CoopPlayerName( n, name, sizeof( name ) );
+	G_CoopPlayerName( reviverNum, reviverName, sizeof( reviverName ) );
+	gi.SendServerCommand( n, "cp \"%s revived you!\"", reviverName );
+	gi.SendServerCommand( reviverNum, "cp \"You revived %s!\"", name );
+}
+
+static void G_CoopGameOver( void )
+{
+	gentity_t *world = &g_entities[ENTITYNUM_WORLD];
+
+	s_coopGameOver = qtrue;
+	// joiners first, the host last, so the host's death (and his "mission
+	// failed" screen / reload) comes after everyone else's
+	for ( int i = MAX_CLIENTS - 1; i >= 0; i-- )
+	{
+		if ( !s_coopDown[i].downed )
+		{
+			continue;
+		}
+		gentity_t *ent = &g_entities[i];
+		G_CoopDownClear( i );
+		if ( ent->client && ent->health > 0 )
+		{
+			ent->client->ps.legsAnimTimer = 0;
+			ent->client->ps.torsoAnimTimer = 0;
+			G_Damage( ent, world, world, NULL, NULL, 10000,
+				DAMAGE_NO_PROTECTION|DAMAGE_NO_ARMOR|DAMAGE_NO_KNOCKBACK, MOD_UNKNOWN );
+		}
+	}
+}
+
+// once per server frame (G_RunFrame)
+void G_CoopReviveThink( void )
+{
+	const int dt = s_coopReviveLastTime ? level.time - s_coopReviveLastTime : 0;
+	s_coopReviveLastTime = level.time;
+
+	if ( s_coopGameOver )
+	{
+		return;
+	}
+
+	int up = 0, down = 0;
+	for ( int i = 0; i < MAX_CLIENTS; i++ )
+	{
+		gentity_t *ent = &g_entities[i];
+		if ( !G_CoopPlayerActive( i ) || !ent->client )
+		{
+			if ( s_coopDown[i].downed )
+			{
+				G_CoopDownClear( i );	// left the game while down
+			}
+			continue;
+		}
+		ent->client->ps.stats[STAT_COOP_REVIVE] = 0;
+		if ( s_coopDown[i].downed )
+		{
+			if ( ent->health <= 0 )
+			{// really died anyway (script, kill command)
+				G_CoopDownClear( i );
+				continue;
+			}
+			down++;
+			ent->client->ps.stats[STAT_COOP_DOWNED] = 1;
+			G_CoopHoldDownedPose( ent );
+		}
+		else
+		{
+			ent->client->ps.stats[STAT_COOP_DOWNED] = 0;
+			if ( ent->health > 0 )
+			{
+				up++;
+			}
+		}
+	}
+
+	if ( !down )
+	{
+		return;
+	}
+	if ( !up )
+	{
+		G_CoopGameOver();
+		return;
+	}
+
+	for ( int d = 0; d < MAX_CLIENTS; d++ )
+	{
+		if ( !s_coopDown[d].downed )
+		{
+			continue;
+		}
+		gentity_t	*downed = &g_entities[d];
+		int			reviver = -1;
+
+		for ( int r = 0; r < MAX_CLIENTS; r++ )
+		{
+			if ( r == d || !G_CoopPlayerUp( r ) )
+			{
+				continue;
+			}
+			gentity_t *ent = &g_entities[r];
+			if ( DistanceSquared( ent->currentOrigin, downed->currentOrigin ) > COOP_REVIVE_RANGE * COOP_REVIVE_RANGE )
+			{
+				continue;
+			}
+			if ( ( ent->client->buttons & BUTTON_USE ) && !in_camera
+				&& ( reviver < 0 || r == s_coopDown[d].reviver ) )
+			{
+				reviver = r;
+			}
+			else if ( ent->client->ps.stats[STAT_COOP_DOWNED] == 0 )
+			{
+				ent->client->ps.stats[STAT_COOP_DOWNED] = 2;	// show "hold USE to revive"
+			}
+		}
+
+		if ( reviver < 0 )
+		{
+			s_coopDown[d].progress = 0;
+			s_coopDown[d].reviver = -1;
+			continue;
+		}
+		if ( reviver != s_coopDown[d].reviver )
+		{
+			s_coopDown[d].progress = 0;
+			s_coopDown[d].reviver = reviver;
+		}
+		s_coopDown[d].progress += dt;
+		if ( s_coopDown[d].progress >= COOP_REVIVE_TIME )
+		{
+			G_CoopRevive( downed, reviver );
+			continue;
+		}
+		int pct = s_coopDown[d].progress * 100 / COOP_REVIVE_TIME;
+		if ( pct < 1 )
+		{
+			pct = 1;
+		}
+		downed->client->ps.stats[STAT_COOP_REVIVE] = pct;
+		g_entities[reviver].client->ps.stats[STAT_COOP_REVIVE] = pct;
+		g_entities[reviver].client->ps.stats[STAT_COOP_DOWNED] = 0;
+	}
+}
+
+/*
+================
+jk2coop round 24: level crawl bot (host side)
+
+A test mode for tools/windows/jk2coop-levelcrawl.ps1 (off unless coop_crawl 1).
+It walks the campaign one map at a time with a real joiner connected and writes
+one machine-readable line per event to coop_crawl_log:
+
+  MAP_START idx=<n> map=<name> expected=<name>
+  JOINED    map=<name> after=<ms>
+  TOUR      map=<name> point=<k> at=<x y z> target=<classname>
+  RESULT    map=<name> PASS|FAIL reason=<...> joined_after=<ms> tour=<k>
+  DONE      maps=<count>
+
+Per map: wait until coop_crawl_players humans are in the game (joiner loaded
+the map and spawned), keep them there coop_crawl_dwell seconds while moving
+both to a different spot of the level every few seconds (so the joiner renders
+the whole map: fog, sky portals, movers, effects), then load the next map with
+maptransition -- the same command a real level exit uses, so joiners follow
+the real way. Players are god-moded and untargetable, level exits are blocked
+(the bot decides when to leave) and nothing else about the game changes. The
+joiner's own game logs what it saw (cg_view.cpp CG_CoopCrawlFrame); the
+launcher scores both logs plus crashes and dropped joiners.
+================
+*/
+static const char *s_coopCrawlDefaultMaps =
+	"kejim_post kejim_base artus_mine artus_detention artus_topside valley "
+	"yavin_temple yavin_trial ns_streets ns_hideout ns_starpad bespin_undercity "
+	"bespin_streets bespin_platform cairn_bay cairn_assembly cairn_reactor "
+	"cairn_dock1 doom_comm doom_detention doom_shields yavin_swamp yavin_canyon "
+	"yavin_courtyard yavin_final pit";
+
+// All crawl timing is REAL time (the client clock), not level.time: level time
+// stops while a video plays and runs 100x while a cutscene is being skipped.
+static int G_CoopCrawlNow( void ) { return gi.Milliseconds(); }	// Sys_Milliseconds (real time)
+extern void CGCam_Disable( void );
+
+static struct
+{
+	int		levelStart;		// real ms of the first crawl frame on this map (0 = not started)
+	int		joinedAt;		// real ms all players were in (0 = waiting)
+	int		nextTour;		// real ms of the next tour hop
+	int		tourCount;
+	int		tourEnt;		// entity scan position for the next hop
+	int		doneAt;			// real ms the result was written (0 = running)
+	int		nextStatus;		// real ms of the next STATUS line
+	int		cameraSince;	// real ms the current cutscene started (0 = none)
+	qboolean	quitSent;
+	int		lastCmdTime[MAX_CLIENTS];
+	int		lastCmdSeen[MAX_CLIENTS];	// real ms the command clock last moved (0 = not looked at yet)
+	qboolean	cmdMoved[MAX_CLIENTS];
+} s_crawl;
+
+qboolean G_CoopCrawlActive( void )
+{
+	if ( cg_remoteClient )
+	{
+		return qfalse;
+	}
+	cvar_t *c = gi.cvar( "coop_crawl", "0", 0 );
+	return (qboolean)( c && c->integer );
+}
+
+static void G_CoopCrawlLog( const char *format, ... )
+{
+	cvar_t *path = gi.cvar( "coop_crawl_log", "", 0 );
+	if ( !path || !path->string[0] )
+	{
+		return;
+	}
+	va_list	argptr;
+	char	text[1024];
+	va_start( argptr, format );
+	Q_vsnprintf( text, sizeof( text ), format, argptr );
+	va_end( argptr );
+	FILE *f = fopen( path->string, "a" );
+	if ( f )
+	{
+		fprintf( f, "%s\n", text );
+		fclose( f );
+	}
+	gi.Printf( "[crawl] %s\n", text );
+}
+
+// the n-th word of the map list ("" when past the end); returns the word count
+static int G_CoopCrawlMap( int n, char *out, int outSize )
+{
+	cvar_t		*maps = gi.cvar( "coop_crawl_maps", s_coopCrawlDefaultMaps, 0 );
+	const char	*p = ( maps && maps->string[0] ) ? maps->string : s_coopCrawlDefaultMaps;
+	int			count = 0;
+
+	out[0] = 0;
+	while ( *p )
+	{
+		while ( *p == ' ' )
+		{
+			p++;
+		}
+		if ( !*p )
+		{
+			break;
+		}
+		const char *start = p;
+		while ( *p && *p != ' ' )
+		{
+			p++;
+		}
+		if ( count == n )
+		{
+			Q_strncpyz( out, start, ( p - start + 1 < outSize ) ? (int)( p - start + 1 ) : outSize );
+		}
+		count++;
+	}
+	return count;
+}
+
+// move every player to a new spot of the level: next to an item, NPC spawner,
+// door or trigger further along the entity list
+static void G_CoopCrawlTour( void )
+{
+	gentity_t *host = &g_entities[0];
+	for ( int tries = 0; tries < MAX_GENTITIES; tries++ )
+	{
+		s_crawl.tourEnt++;
+		if ( s_crawl.tourEnt >= globals.num_entities )
+		{
+			s_crawl.tourEnt = MAX_CLIENTS;
+		}
+		gentity_t *t = &g_entities[s_crawl.tourEnt];
+		if ( !t->inuse || !t->classname || t->client )
+		{
+			continue;
+		}
+		if ( Q_stricmpn( t->classname, "NPC_", 4 ) && Q_stricmpn( t->classname, "item_", 5 )
+			&& Q_stricmpn( t->classname, "weapon_", 7 ) && Q_stricmpn( t->classname, "ammo_", 5 )
+			&& Q_stricmp( t->classname, "func_door" ) && Q_stricmp( t->classname, "misc_model_breakable" ) )
+		{
+			continue;
+		}
+		vec3_t	org, spot;
+		if ( t->bmodel )
+		{// brush entity: its middle
+			VectorAdd( t->absmin, t->absmax, org );
+			VectorScale( org, 0.5f, org );
+		}
+		else
+		{
+			VectorCopy( t->currentOrigin, org );
+		}
+		// stand on the floor at that spot (start a bit up, drop down)
+		trace_t	tr;
+		vec3_t	up, down;
+		VectorCopy( org, up );
+		up[2] += 32.0f;
+		VectorCopy( org, down );
+		down[2] -= 256.0f;
+		gi.trace( &tr, up, host->mins, host->maxs, down, host->s.number, MASK_PLAYERSOLID, G2_NOCOLLIDE, 0 );
+		if ( tr.startsolid || tr.allsolid || tr.fraction >= 1.0f )
+		{
+			continue;
+		}
+		VectorCopy( tr.endpos, spot );
+		G_CoopPlaceJoiner( host, spot, host->client->ps.viewangles );
+		G_CoopBringJoinersToHost( qfalse );
+		s_crawl.tourCount++;
+		G_CoopCrawlLog( "TOUR map=%s point=%d at=%d %d %d target=%s", level.mapname, s_crawl.tourCount,
+			(int)spot[0], (int)spot[1], (int)spot[2], t->classname );
+		return;
+	}
+}
