+// current frame of an entity's legs on our screen (-1 = no skeleton)
+static float CG_CoopTestLegsFrame( int num )
+{
+	gentity_t *g = &g_entities[num];
+	if ( !g->ghoul2.IsValid() || g->playerModel < 0 || g->rootBone < 0 )
+	{
+		return -1.0f;
+	}
+	float frame = -1.0f, speed = 0.0f;
+	int sf = 0, ef = 0, fl = 0;
+	if ( !gi.G2API_GetBoneAnimIndex( &g->ghoul2[g->playerModel], g->rootBone, cg.time, &frame, &sf, &ef, &fl, &speed, 0 ) )
+	{
+		return -1.0f;
+	}
+	return frame;
+}
+
+static qboolean CG_CoopTestInSnap( int num )
+{
+	for ( int k = 0; k < cg.snap->numEntities; k++ )
+	{
+		if ( cg.snap->entities[k].number == num )
+		{
+			return qtrue;
+		}
+	}
+	return (qboolean)( num >= 0 && num < MAX_CLIENTS );	// players are always sent
+}
