 extern void G_SetG2PlayerModel( gentity_t * const ent, const char *modelName, const char *customSkin, const char *surfOff, const char *surfOn );
+
+/*
+jk2coop: an NPC's voice (pain grunts, death cries, combat chatter) comes from
+the sound folders named in its .npc file (snd/sndcombat/sndextra/sndjedi),
+which only the host ever reads. Joiners never learned them, so every NPC was
+silent on their screen. Put the four folder names in a configstring in the
+CS_RESERVED1 block (96 slots that nothing else uses, so the map's sound/model
+tables can never overflow because of this) and send its index in the NPC's
+otherwise unused entityState modelindex3. The joiner's cgame reads it back
+(CG_RemoteNPCVoice, cg_players.cpp). Never fatal: returns 0 (no voice) if the
+block is full.
+*/
+static int G_CoopNPCVoiceIndex( const clientInfo_t *ci, int npcClass, int saberColor )
+{
+	char	name[MAX_STRING_CHARS];
+	char	s[MAX_STRING_CHARS];
+	int		i;
+
+	// jk2coop: the 5th field is the NPC class (droid vs humanoid decides how
+	// the joiner poses the body, CG_G2PlayerAngles)
+	// round 16: 6th field = saber colour
+	Com_sprintf( name, sizeof( name ), COOP_NPC_VOICE_PREFIX "%s %s %s %s %d %d",
+		( ci->customBasicSoundDir && ci->customBasicSoundDir[0] ) ? ci->customBasicSoundDir : "-",
+		( ci->customCombatSoundDir && ci->customCombatSoundDir[0] ) ? ci->customCombatSoundDir : "-",
+		( ci->customExtraSoundDir && ci->customExtraSoundDir[0] ) ? ci->customExtraSoundDir : "-",
+		( ci->customJediSoundDir && ci->customJediSoundDir[0] ) ? ci->customJediSoundDir : "-",
+		npcClass, saberColor );
+
+	for ( i = 1; i < COOP_NPC_VOICE_MAX; i++ )
+	{
+		gi.GetConfigstring( CS_COOP_NPCVOICE + i, s, sizeof( s ) );
+		if ( !s[0] )
+		{
+			break;
+		}
+		if ( !Q_stricmp( s, name ) )
+		{
+			return i;
+		}
+	}
+	if ( i >= COOP_NPC_VOICE_MAX )
+	{
+		return 0;
+	}
+	gi.SetConfigstring( CS_COOP_NPCVOICE + i, name );
+	return i;
+}
