+			const qboolean good = (qboolean)( team == wantTeam[k] && tr.entityNum == n );
+			ok = (qboolean)( ok && good );
+			checked++;
+			Q_strcat( d, sizeof( d ), va( "ent%d team=%d/%d trace_hit=%d; ", n, team, wantTeam[k], tr.entityNum ) );
+		}
+		CG_CoopTestResult( (qboolean)( ok && checked > 0 ), d );
+	}
+	else if ( !Q_stricmp( t, "charge" ) )
+	{
+		const int glows = g_coopChargeGlowCount - s_coopTest.chargeBase;
+		cgi_Cvar_Set( "cg_thirdperson", s_coopTest.thirdPerson );
+		Com_sprintf( d, sizeof( d ), "glow_frames=%d weapon=%d", glows, cg.snap->ps.weapon );
+		CG_CoopTestResult( (qboolean)( glows > 0 ), d );
+	}
+	else if ( !Q_stricmp( t, "menuclock" ) )
+	{
+		const float b = CG_CoopTestLegsFrame( atoi( s_coopTest.arg[0] ) );
+		Com_sprintf( d, sizeof( d ), "host_legs_frame %.1f -> %.1f (must move after a menu)", s_coopTest.frameA, b );
+		CG_CoopTestResult( (qboolean)( s_coopTest.frameA >= 0.0f && b >= 0.0f && b != s_coopTest.frameA ), d );
+	}
+	else if ( !Q_stricmp( t, "revive" ) )
+	{
+		const int want = atoi( s_coopTest.arg[0] );
+		const int downed = cg.snap->ps.stats[STAT_COOP_DOWNED];
+		const qboolean ok = want ? (qboolean)( downed == 1 && cg.renderingThirdPerson )
