+/*
+===============
+IN_GamepadMove
+
+jk2coop: poll an SDL game controller (see the table at the top)
+===============
+*/
+static void IN_GamepadSendAxis( int gameAxis, int value )
+{
+	if ( gamepad_state.axis[gameAxis] != value )
+	{
+		gamepad_state.axis[gameAxis] = value;
+		Sys_QueEvent( 0, SE_JOYSTICK_AXIS, gameAxis, value, 0, NULL );
+	}
+}
+
+static void IN_GamepadMove( void )
+{
+	const qboolean	inMenu = (qboolean)( ( Key_GetCatcher( ) & KEYCATCH_UI ) != 0 );
+	const qboolean	inConsole = (qboolean)( ( Key_GetCatcher( ) & KEYCATCH_CONSOLE ) != 0 );
+
+	SDL_GameControllerUpdate( );
+
+	if ( !SDL_GameControllerGetAttached( gamepad ) )
+	{// unplugged: release everything once, then wait for IN_Restart
+		for ( size_t i = 0; i < ARRAY_LEN( gamepadButtons ); i++ )
+		{
+			if ( gamepad_state.sentKey[i] )
+			{
+				Sys_QueEvent( 0, SE_KEY, gamepad_state.sentKey[i], qfalse, 0, NULL );
+				gamepad_state.sentKey[i] = 0;
+			}
+		}
+		for ( int t = 0; t < 2; t++ )
+		{
+			if ( gamepad_state.triggerKey[t] )
+			{
+				Sys_QueEvent( 0, SE_KEY, gamepad_state.triggerKey[t], qfalse, 0, NULL );
+				gamepad_state.triggerKey[t] = 0;
+			}
+		}
+		for ( int a = 0; a < MAX_JOYSTICK_AXIS; a++ )
+		{
+			IN_GamepadSendAxis( a, 0 );
+		}
+		return;
+	}
+
+	// buttons. In menus a few of them act like mouse/keyboard so the
+	// (mouse-driven) Jedi Outcast menus can be used from the couch. The key
+	// sent on press is remembered so the release always matches it, even if
+	// a menu opened or closed in between.
+	for ( size_t i = 0; i < ARRAY_LEN( gamepadButtons ); i++ )
+	{
+		const qboolean pressed = (qboolean)( SDL_GameControllerGetButton( gamepad, gamepadButtons[i].button ) != 0 );
+		if ( pressed && !gamepad_state.sentKey[i] )
+		{
+			int key = gamepadButtons[i].key;
+			if ( gamepadButtons[i].button == SDL_CONTROLLER_BUTTON_START )
+			{
+				key = A_ESCAPE;	// Start always opens / closes the menu (Escape can't be rebound)
+			}
+			else if ( inMenu )
+			{
+				switch ( gamepadButtons[i].button )
+				{
+				case SDL_CONTROLLER_BUTTON_A:			key = A_MOUSE1;			break;
+				case SDL_CONTROLLER_BUTTON_B:			key = A_ESCAPE;			break;
+				case SDL_CONTROLLER_BUTTON_DPAD_UP:		key = A_CURSOR_UP;		break;
+				case SDL_CONTROLLER_BUTTON_DPAD_DOWN:	key = A_CURSOR_DOWN;	break;
+				case SDL_CONTROLLER_BUTTON_DPAD_LEFT:	key = A_CURSOR_LEFT;	break;
+				case SDL_CONTROLLER_BUTTON_DPAD_RIGHT:	key = A_CURSOR_RIGHT;	break;
+				default:														break;
+				}
+			}
+			gamepad_state.sentKey[i] = key;
+			Sys_QueEvent( 0, SE_KEY, key, qtrue, 0, NULL );
+		}
+		else if ( !pressed && gamepad_state.sentKey[i] )
+		{
+			Sys_QueEvent( 0, SE_KEY, gamepad_state.sentKey[i], qfalse, 0, NULL );
+			gamepad_state.sentKey[i] = 0;
+		}
+	}
+
+	// triggers -> JOY16 / JOY17, with a little hysteresis so a half-pulled
+	// trigger doesn't flicker
+	const SDL_GameControllerAxis triggerAxes[2] = { SDL_CONTROLLER_AXIS_TRIGGERLEFT, SDL_CONTROLLER_AXIS_TRIGGERRIGHT };
+	const int triggerKeys[2] = { GAMEPAD_TRIGGER_LEFT_KEY, GAMEPAD_TRIGGER_RIGHT_KEY };
+	float threshold = joy_triggerThreshold->value;
+	if ( threshold < 0.05f ) threshold = 0.05f;
+	if ( threshold > 0.95f ) threshold = 0.95f;
+	for ( int t = 0; t < 2; t++ )
+	{
+		const float v = SDL_GameControllerGetAxis( gamepad, triggerAxes[t] ) / 32767.0f;
+		if ( !gamepad_state.triggerKey[t] && v > threshold )
+		{
+			gamepad_state.triggerKey[t] = ( inMenu && t == 1 ) ? A_MOUSE1 : triggerKeys[t];
+			Sys_QueEvent( 0, SE_KEY, gamepad_state.triggerKey[t], qtrue, 0, NULL );
+		}
+		else if ( gamepad_state.triggerKey[t] && v < threshold * 0.5f )
+		{
+			Sys_QueEvent( 0, SE_KEY, gamepad_state.triggerKey[t], qfalse, 0, NULL );
+			gamepad_state.triggerKey[t] = 0;
+		}
+	}
+
+	const int lx = SDL_GameControllerGetAxis( gamepad, SDL_CONTROLLER_AXIS_LEFTX );
+	const int ly = SDL_GameControllerGetAxis( gamepad, SDL_CONTROLLER_AXIS_LEFTY );
+	const int rx = SDL_GameControllerGetAxis( gamepad, SDL_CONTROLLER_AXIS_RIGHTX );
+	const int ry = SDL_GameControllerGetAxis( gamepad, SDL_CONTROLLER_AXIS_RIGHTY );
+
+	if ( inMenu || inConsole )
+	{// no walking around behind a menu; the left stick drives the menu cursor
+		for ( int a = 0; a < MAX_JOYSTICK_AXIS; a++ )
+		{
+			IN_GamepadSendAxis( a, 0 );
+		}
+		if ( inMenu )
+		{
+			const float deadzone = 0.2f;
+			float fx = lx / 32767.0f, fy = ly / 32767.0f;
+			if ( fabsf( fx ) < deadzone ) fx = 0.0f;
+			if ( fabsf( fy ) < deadzone ) fy = 0.0f;
+			const float secs = cls.realFrametime * 0.001f;
+			gamepad_state.cursorFracX += fx * fabsf( fx ) * joy_menuCursorSpeed->value * secs;
+			gamepad_state.cursorFracY += fy * fabsf( fy ) * joy_menuCursorSpeed->value * secs;
+			const int dx = (int)gamepad_state.cursorFracX;
+			const int dy = (int)gamepad_state.cursorFracY;
+			gamepad_state.cursorFracX -= dx;
+			gamepad_state.cursorFracY -= dy;
+			if ( dx || dy )
+			{
+				Sys_QueEvent( 0, SE_MOUSE, dx, dy, 0, NULL );
+			}
+		}
+		return;
+	}
+
+	// sticks: raw values, cl_input.cpp applies deadzone / curve / speed
+	IN_GamepadSendAxis( AXIS_SIDE, lx );
+	IN_GamepadSendAxis( AXIS_FORWARD, ly );
+	IN_GamepadSendAxis( AXIS_YAW, rx );
+	IN_GamepadSendAxis( AXIS_PITCH, ry );
+}
