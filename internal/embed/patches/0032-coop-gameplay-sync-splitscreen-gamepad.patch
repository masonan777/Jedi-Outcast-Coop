+static void CL_CoopNewGame_f( void )
+{
+	int maxPlayers = ( Cmd_Argc() > 1 ) ? atoi( Cmd_Argv( 1 ) ) : 2;
+	if ( maxPlayers < 2 )
+	{
+		maxPlayers = 2;
+	}
+	if ( maxPlayers > MAX_CLIENTS )
+	{
+		maxPlayers = MAX_CLIENTS;
+	}
+	const char *map = ( Cmd_Argc() > 2 ) ? Cmd_Argv( 2 ) : "kejim_post";
+	Cbuf_AddText( va( "map %s\ncoop_host %d\n", map, maxPlayers ) );
+}
+
+static void CL_CoopSplitScreen_f( void )
+{
+	if ( Sys_CoopChildRunning() )
+	{
+		Com_Printf( "Split screen is already running.\n" );
+		return;
+	}
+	const qboolean newGame = (qboolean)!com_sv_running->integer;
+	const char *map = ( Cmd_Argc() > 1 ) ? Cmd_Argv( 1 ) : "kejim_post";
+	const int pads = IN_CoopControllerCount();
+
+	if ( pads >= 2 )
+	{// one controller each: player 1 takes the first
+		Cvar_Set( "in_joystick", "1" );
+		Cvar_Set( "in_gamepad", "1" );
+		Cvar_Set( "in_joystickBackground", "1" );
+		Cvar_Set( "in_joystickNo", "0" );
+		Cbuf_AddText( "exec jk2coop_gamepad.cfg\n" );
+		s_coopSplitPad = 1;
+		Com_Printf( "Split screen: 2 controllers found - player 1 uses controller 1, player 2 controller 2.\n" );
+	}
+	else
+	{// player 2 gets the only controller, player 1 keeps keyboard and mouse
+		Cvar_Set( "in_joystick", "0" );
+		s_coopSplitPad = 0;
+		if ( pads == 1 )
+		{
+			Com_Printf( "Split screen: 1 controller found - player 2 uses it, player 1 keyboard and mouse.\n" );
+		}
+		else
+		{
+			Com_Printf( S_COLOR_YELLOW "Split screen: no controller found - plug one in for player 2.\n" );
+		}
+	}
+	Cvar_Set( "r_fullscreen", "0" );
+	Cvar_Set( "r_splitscreen", "1" );
+	Cbuf_AddText( "vid_restart\n" );
+	if ( newGame )
+	{
+		Cbuf_AddText( va( "map %s\ncoop_host 2\n", map ) );
+	}
+	else
+	{
+		Cbuf_AddText( "coop_host 2\n" );
+	}
+	s_coopSplitPending = qtrue;
+	s_coopSplitTime = Sys_Milliseconds();
+}
+
+// once the level is up and the network is open, start player 2's game
+static void CL_CoopSplitScreenFrame( void )
+{
+	if ( !s_coopSplitPending )
+	{
+		return;
+	}
+	if ( Sys_Milliseconds() - s_coopSplitTime > 180000 )
+	{
+		s_coopSplitPending = qfalse;
+		Com_Printf( S_COLOR_YELLOW "Split screen: the game didn't start, player 2 was not launched.\n" );
+		return;
+	}
+	if ( !com_sv_running->integer || cls.state != CA_ACTIVE || !NET_IsSocketOpen() )
+	{
+		return;
+	}
+	s_coopSplitPending = qfalse;
+
+	char base[MAX_OSPATH], home[MAX_OSPATH];
+	Cvar_VariableStringBuffer( "fs_basepath", base, sizeof( base ) );
+	Cvar_VariableStringBuffer( "fs_homepath", home, sizeof( home ) );
+	if ( !home[0] )
+	{
+		Q_strncpyz( home, base, sizeof( home ) );
+	}
+	// an installed copy reads the player's own game data through fs_cdpath
+	char cdpath[MAX_OSPATH], cdarg[MAX_OSPATH + 32];
+	Cvar_VariableStringBuffer( "fs_cdpath", cdpath, sizeof( cdpath ) );
+	cdarg[0] = 0;
+	if ( cdpath[0] )
+	{
+		Com_sprintf( cdarg, sizeof( cdarg ), " +set fs_cdpath \"%s\"", cdpath );
+	}
+	const int port = Cvar_VariableIntegerValue( "net_port" );
+	const char *args = va(
+		"+set fs_basepath \"%s\"%s +set fs_homepath \"%s%ccoop-p2\" +set net_enabled 1"
+		" +set r_fullscreen 0 +set r_splitscreen 2 +set r_ignorehwgamma 1"
+		" +set in_joystick 1 +set in_gamepad 1 +set in_joystickBackground 1 +set in_joystickNo %d"
+		" +exec jk2coop_gamepad.cfg +connect localhost:%d",
+		base, cdarg, home, PATH_SEP, s_coopSplitPad, port > 0 ? port : 29070 );
+	if ( Sys_CoopStartChild( args ) )
+	{
+		Com_Printf( "Split screen: starting player 2.\n" );
+	}
+	else
+	{
+		Com_Printf( S_COLOR_RED "Split screen: couldn't start player 2's game.\n" );
+	}
+}
