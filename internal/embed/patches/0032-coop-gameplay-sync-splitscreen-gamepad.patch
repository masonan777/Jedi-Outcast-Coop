+/*
+jk2coop round 15 (joiner only): rebuild the host-only emplaced-gun links from
+what the host now networks (g_main.cpp): the gun's health / max health / god
+mode in s.time2 and the seated player in s.otherEntityNum2. The joiner's copy of
+that player then "is owned by" the gun exactly like on the host, so the gun
+HUD (CG_DrawCustomHealthHud), the seat placement (CG_Player) and the camera
+behind the gun (below) all work on the joiner's own screen.
+*/
+#ifndef FL_GODMODE
+#define FL_GODMODE 0x00000010	// g_local.h
+#endif
+static void CG_RemoteEmplacedSync( void )
+{
+	if ( !cg_remoteClient || !cg.snap )
+	{
+		return;
+	}
+	const int local = cg.snap->ps.clientNum;
+	qboolean seated[MAX_CLIENTS] = { qfalse };
+
+	for ( int k = 0; k < cg.snap->numEntities; k++ )
+	{
+		const entityState_t *es = &cg.snap->entities[k];
+		if ( es->eType != ET_GENERAL || es->weapon != WP_EMPLACED_GUN || es->number < MAX_CLIENTS || es->number >= ENTITYNUM_WORLD )
+		{
+			continue;
+		}
+		gentity_t *gun = &g_entities[es->number];
+		VectorCopy( es->pos.trBase, gun->currentOrigin );
+		if ( es->time2 )
+		{
+			gun->health = es->time2 & 0x7fff;
+			gun->max_health = ( es->time2 >> 15 ) & 0x7fff;
+			if ( es->time2 & ( 1 << 30 ) )
+			{
+				gun->flags |= FL_GODMODE;
+			}
+			else
+			{
+				gun->flags &= ~FL_GODMODE;
+			}
+		}
+		const int n = es->otherEntityNum2;
+		if ( n >= 0 && n < MAX_CLIENTS )
+		{
+			const int ef = ( n == local ) ? cg.snap->ps.eFlags : cg_entities[n].currentState.eFlags;
+			if ( ef & EF_LOCKED_TO_WEAPON )
+			{
+				g_entities[n].owner = gun;
+				seated[n] = qtrue;
+			}
+		}
+	}
+	for ( int i = 0; i < MAX_CLIENTS; i++ )
+	{
+		if ( !seated[i] )
+		{
+			g_entities[i].owner = NULL;
+		}
+	}
+	// the gun HUD shows the gunner's own health when the gun can't be hurt
+	g_entities[local].health = cg.snap->ps.stats[STAT_HEALTH];
+	g_entities[local].max_health = cg.snap->ps.stats[STAT_MAX_HEALTH] > 0 ? cg.snap->ps.stats[STAT_MAX_HEALTH] : 100;
+}
+
+/*
+jk2coop round 19 (joiner only): drawing the lightsaber switches to the third
+person view and switching back to a gun returns to first person (cvars
+cg_saberAutoThird / cg_gunAutoFirst). The host's game does this inside its
+movement code for player 0 only, setting ITS OWN cvar, so player 2 never got it.
+Watch our own weapon in the snapshot and do the same here.
+*/
+static void CG_RemoteAutoCamera( void )
+{
+	static int s_lastWeapon = -1;
+	if ( !cg_remoteClient || !cg.snap )
+	{
+		return;
+	}
+	const int weapon = cg.snap->ps.weapon;
+	if ( s_lastWeapon != -1 && weapon != s_lastWeapon && !( cg.snap->ps.eFlags & EF_LOCKED_TO_WEAPON ) )
+	{
+		if ( weapon == WP_SABER && cg_saberAutoThird.value )
+		{
+			cgi_Cvar_Set( "cg_thirdperson", "1" );
+		}
+		else if ( s_lastWeapon == WP_SABER && weapon != WP_NONE && cg_gunAutoFirst.value )
+		{
+			cgi_Cvar_Set( "cg_thirdperson", "0" );
+		}
+	}
+	s_lastWeapon = weapon;
+
+	// jk2coop round 20: tell the host which Force power we have selected, so our
+	// "use Force" button uses OUR selection (host: "coopforce", g_cmds.cpp)
+	static int s_sentForce = -1;
+	extern int showPowers[];
+	const int power = showPowers[cg.forcepowerSelect];
+	if ( power != s_sentForce )
+	{
+		s_sentForce = power;
+		cgi_SendConsoleCommand( va( "coopforce %d\n", power ) );
+	}
+}
