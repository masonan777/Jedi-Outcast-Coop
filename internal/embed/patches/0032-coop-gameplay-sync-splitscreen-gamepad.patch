+/*
+================
+G_CoopForceFxSync
+
+jk2coop round 22: the Force glow on a user's hand (push, pull, grip), the
+lightning, the speed blur and the ripple on whatever is being pushed are all
+drawn by cgame from host-only state (playerState timers / forcePowersActive and
+gentity_t::forcePushTime). A joiner's copies of other characters never had any
+of it, so P2 saw the gestures with no effects. Pack it into spare bits of
+entityState_t.powerups at the very end of the frame (after every
+PlayerStateToEntityState), which goes out with the snapshot.
+================
+*/
+static void G_CoopForceFxSync( void )
+{
+	if ( cg_remoteClient )
+	{
+		return;
+	}
+	const int coopBits = ( 1 << PW_FORCE_PUSH ) | ( 1 << COOP_PWB_GRIP ) | ( 1 << COOP_PWB_LIGHTNING )
+		| ( 1 << COOP_PWB_LIGHTNING_WIDE ) | ( 1 << COOP_PWB_PUSHED ) | ( 1 << COOP_PWB_SPEED )
+		| COOP_PWB_TEAM_MASK | ( 1 << COOP_PWB_NONNPC_ENEMY );
+	for ( int i = 0; i < ENTITYNUM_WORLD; i++ )
+	{
+		gentity_t *ent = &g_entities[i];
+		if ( !ent->inuse )
+		{
+			continue;
+		}
+		int pw = ent->s.powerups & ~coopBits;
+		if ( ent->forcePushTime > level.time )
+		{
+			pw |= ( 1 << COOP_PWB_PUSHED );
+		}
+		// round 33: team, for the joiner's crosshair colour
+		if ( ent->client )
+		{
+			pw |= ( ( ent->client->playerTeam + 1 ) & 7 ) << COOP_PWB_TEAM_SHIFT;
+		}
+		else if ( ent->s.weapon == WP_TURRET )
+		{
+			pw |= ( ( ent->noDamageTeam + 1 ) & 7 ) << COOP_PWB_TEAM_SHIFT;
+			if ( ent->svFlags & SVF_NONNPC_ENEMY )
+			{
+				pw |= ( 1 << COOP_PWB_NONNPC_ENEMY );
+			}
+		}
+		if ( ent->client )
+		{
+			const playerState_t *ps = &ent->client->ps;
+			// PlayerStateToEntityState sets this bit whenever the timer is
+			// non-zero, and only players get it cleared when it runs out
+			if ( ps->powerups[PW_FORCE_PUSH] > level.time )
+			{
+				pw |= ( 1 << PW_FORCE_PUSH );
+			}
+			if ( ps->forcePowersActive & ( 1 << FP_GRIP ) )
+			{
+				pw |= ( 1 << COOP_PWB_GRIP );
+			}
+			if ( ps->forcePowersActive & ( 1 << FP_LIGHTNING ) )
+			{
+				pw |= ( 1 << COOP_PWB_LIGHTNING );
+				if ( ps->forcePowerLevel[FP_LIGHTNING] > 2 )	// FORCE_LEVEL_2 (wp_saber.h)
+				{
+					pw |= ( 1 << COOP_PWB_LIGHTNING_WIDE );
+				}
+			}
+			if ( ps->forcePowersActive & ( 1 << FP_SPEED ) )
+			{
+				pw |= ( 1 << COOP_PWB_SPEED );
+			}
+		}
+		ent->s.powerups = pw;
+	}
+}
+
+/*
+================
+jk2coop round 31: campaign state, cutscenes and remote views for joiners
+
+Single player keeps the objectives (client 0's session), the mission-failed
+screen and the cutscene camera inside the host's own process, and a joiner's
+game never sees any of it: an empty datapad, no "Mission failed" text, and
+the player standing frozen in the world during cutscenes instead of watching
+them. Send them on:
+
+- G_CoopCampaignSync: objectives + mission status + the camera's entity
+  number in one configstring (CS_COOP_STATE), only when something changed.
+  Configstrings are part of the game state, so a late joiner gets them too.
+- G_CoopCutsceneSync: while the host's cutscene camera runs (or its black
+  bars / fade are still on screen) an invisible broadcast entity carries the
+  camera's final view each frame -- origin, angles, FOV, bar size, fade
+  colour. The joiner's game copies it into its own camera and so draws the
+  same shot with the same letterbox and HUD rules.
+- G_CoopViewKindSync: what each player looks through (security camera,
+  turret, droid), which the joiner's game can't tell from its empty copies of
+  those entities.
+================
+*/
+coopCamView_t	g_coopCamView;		// written by the host's cgame every frame (cg_view.cpp)
+static gentity_t	*s_coopCam = NULL;
+static char			s_coopStateLast[MAX_STRING_CHARS];
+
+void G_CoopCampaignReset( void )
+{
+	s_coopCam = NULL;		// the old level's entities are gone (level/g_entities get cleared)
+	s_coopStateLast[0] = 0;	// resend the state on the new level
+	memset( &g_coopCamView, 0, sizeof( g_coopCamView ) );
+}
+
+static void G_CoopCutsceneSync( void )
+{
+	const qboolean show = (qboolean)( G_CoopHasJoiners()
+		&& ( in_camera || client_camera.bar_alpha > 0.0f || client_camera.fade_color[3] > 0.0f ) );
+	if ( !show )
+	{
+		if ( s_coopCam )
+		{
+			if ( s_coopCam->inuse && !Q_stricmp( s_coopCam->classname, "coop_cutscene_cam" ) )
+			{
+				G_FreeEntity( s_coopCam );
+			}
+			s_coopCam = NULL;
+		}
+		return;
+	}
+	if ( !s_coopCam || !s_coopCam->inuse || Q_stricmp( s_coopCam->classname, "coop_cutscene_cam" ) )
+	{
+		s_coopCam = G_Spawn();
+		if ( !s_coopCam )
+		{
+			return;
+		}
+		s_coopCam->classname = "coop_cutscene_cam";
+		s_coopCam->s.eType = ET_INVISIBLE;
+		s_coopCam->svFlags |= SVF_BROADCAST;
+		s_coopCam->contents = 0;
+		s_coopCam->clipmask = 0;
+		VectorClear( s_coopCam->mins );
+		VectorClear( s_coopCam->maxs );
+		s_coopCam->s.modelindex = 0;
+	}
+	gentity_t *cam = s_coopCam;
+	const qboolean viewValid = (qboolean)( in_camera && g_coopCamView.valid );
+	if ( viewValid )
+	{
+		VectorCopy( g_coopCamView.origin, cam->s.pos.trBase );
+		VectorCopy( g_coopCamView.angles, cam->s.apos.trBase );
+		VectorCopy( g_coopCamView.origin, cam->currentOrigin );
+		cam->s.angles2[0] = g_coopCamView.fov;
+	}
+	cam->s.pos.trType = TR_INTERPOLATE;
+	cam->s.apos.trType = TR_INTERPOLATE;
+	VectorClear( cam->s.pos.trDelta );
+	VectorClear( cam->s.apos.trDelta );
+	cam->s.angles2[1] = client_camera.bar_alpha;
+	cam->s.angles2[2] = client_camera.bar_height;
+	cam->s.origin2[0] = client_camera.fade_color[0];
+	cam->s.origin2[1] = client_camera.fade_color[1];
+	cam->s.origin2[2] = client_camera.fade_color[2];
+	cam->s.time2 = (int)( client_camera.fade_color[3] * 1000.0f );
+	cam->s.time = viewValid ? 1 : 0;	// 0 = only the bars / fade are still showing
+	gi.linkentity( cam );
+}
+
+static void G_CoopCampaignSync( void )
+{
+	// round 33: test twin -- the gap test's "obj" check must fail without this
+	cvar_t *twin = gi.cvar( "coop_test_twin", "", 0 );
+	if ( twin && !Q_stricmp( twin->string, "obj" ) )
+	{
+		return;
