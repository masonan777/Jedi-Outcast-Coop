+//----------------------------------------------------------
+// jk2coop: free an emplaced gun from a player who is leaving it WITHOUT the
+// normal exit (ExitEmplacedWeapon) -- a joiner disconnecting while seated, or
+// a stale joiner body left over from a loaded save. Without this the gun keeps
+// thinking that (now gone) player is sitting in it, and nobody can use it.
+//----------------------------------------------------------
+void G_CoopReleaseEmplacedGun( gentity_t *user )
+{
+	if ( !user || !user->client )
+	{
+		return;
+	}
+	gentity_t *gun = user->owner;
+	if ( gun && gun->activator == user )
+	{
+		if ( gun->nextTrain )
+		{//the placeholder that kept the user's standing spot free
+			G_FreeEntity( gun->nextTrain );
+			gun->nextTrain = NULL;
+		}
+		gun->s.weapon = WP_EMPLACED_GUN;	// it was holding the user's old weapon
+		gun->s.loopSound = 0;
+		gun->noDamageTeam = TEAM_FREE;
+		gun->svFlags &= ~SVF_NONNPC_ENEMY;
+		gun->delay = level.time;
+		gun->activator = NULL;
+	}
+	if ( gun && gun->activator != user )
+	{
+		user->owner = NULL;
+	}
+	user->client->ps.eFlags &= ~EF_LOCKED_TO_WEAPON;
+	user->s.eFlags &= ~EF_LOCKED_TO_WEAPON;
+}
