+/*
+================
+jk2coop: keys are shared between the co-op players. In single player only one
+person could ever carry a key; in co-op the one holding it is often not the one
+standing at the door or panel. If the user doesn't have the key but another
+player does, take it from him instead. NPCs never borrow keys.
+================
+*/
+static gentity_t *G_CoopKeyHolder( gentity_t *user, const char *securityKeyName )
+{
+	if ( !user || !user->client )
+	{
+		return NULL;
+	}
+	for ( int pass = 0; pass < 2; pass++ )
+	{
+		for ( int i = 0; i < MAX_CLIENTS; i++ )
+		{
+			gentity_t *ent = pass ? &g_entities[i] : user;	// the user himself first
+			if ( pass && ( !G_IsCoopPlayer( user ) || ent == user || !G_CoopPlayerActive( i ) ) )
+			{
+				continue;
+			}
+			const qboolean has = securityKeyName
+				? INV_SecurityKeyCheck( ent, securityKeyName )
+				: (qboolean)( INV_GoodieKeyCheck( ent ) != 0 );
+			if ( has )
+			{
+				return ent;
+			}
+			if ( !pass )
+			{
+				break;
+			}
+		}
+	}
+	return NULL;
+}
