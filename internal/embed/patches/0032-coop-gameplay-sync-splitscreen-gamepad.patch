+/*
+===============
+IN_CoopControllerCount
+
+jk2coop: how many game controllers are plugged in (for split screen from the
+Co-op menu: with two, each player gets one; with one, player 2 gets it and
+player 1 stays on keyboard and mouse).
+===============
+*/
+int IN_CoopControllerCount( void )
+{
+	const bool wasInit = SDL_WasInit( SDL_INIT_JOYSTICK ) != 0;
+	if ( !wasInit && SDL_InitSubSystem( SDL_INIT_JOYSTICK ) != 0 )
+	{
+		return 0;
+	}
+	int count = 0;
+	const int total = SDL_NumJoysticks();
+	for ( int i = 0; i < total; i++ )
+	{
+		if ( SDL_IsGameController( i ) )
+		{
+			count++;
+		}
+	}
+	if ( !count )
+	{
+		count = total;	// plain joysticks still work through the old path
+	}
+	if ( !wasInit )
+	{
+		SDL_QuitSubSystem( SDL_INIT_JOYSTICK );
+	}
+	return count;
+}
