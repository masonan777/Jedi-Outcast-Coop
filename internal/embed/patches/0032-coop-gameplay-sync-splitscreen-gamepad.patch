+		Com_sprintf( d, sizeof( d ), "want=%d downed=%d health=%d third_person=%d", want, downed, cg.snap->ps.stats[STAT_HEALTH], (int)cg.renderingThirdPerson );
+		CG_CoopTestResult( ok, d );
+	}
+	else
+	{
+		CG_CoopTestResult( qfalse, "unknown test" );
+	}
+}
