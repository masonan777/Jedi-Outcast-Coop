+			ok = (qboolean)( isAtst && cg.renderingThirdPerson && cg.weaponSelect == WP_ATST_MAIN );
+		}
+		else
+		{
+			ok = (qboolean)( !isAtst && cg.weaponSelect != WP_ATST_MAIN && !( cg.overrides.active & CG_OVERRIDE_3RD_PERSON_RNG ) );
+		}
+		Com_sprintf( d, sizeof( d ), "want=%d atst_model=%d third_person=%d weapon=%d", want, isAtst, (int)cg.renderingThirdPerson, cg.weaponSelect );
+		CG_CoopTestResult( ok, d );
+	}
+	else if ( !Q_stricmp( t, "team" ) )
+	{
+		const int ids[3] = { 0, atoi( s_coopTest.arg[0] ), atoi( s_coopTest.arg[1] ) };
+		const int wantTeam[3] = { TEAM_PLAYER, TEAM_PLAYER, TEAM_ENEMY };
+		qboolean ok = qtrue;
+		int checked = 0;
+		d[0] = 0;
+		for ( int k = 0; k < 3; k++ )
+		{
+			const int n = ids[k];
