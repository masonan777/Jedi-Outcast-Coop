+/*
+==================
+jk2coop: split screen from the Co-op menu
+
+Start a second copy of this game (player 2's window) and stop it again when
+this game shuts down. Only one at a time.
+==================
+*/
+static PROCESS_INFORMATION s_coopChild;
+static bool s_coopChildRunning = false;
+
+bool Sys_CoopChildRunning( void )
+{
+	if ( !s_coopChildRunning )
+	{
+		return false;
+	}
+	if ( WaitForSingleObject( s_coopChild.hProcess, 0 ) == WAIT_OBJECT_0 )
+	{
+		CloseHandle( s_coopChild.hProcess );
+		CloseHandle( s_coopChild.hThread );
+		s_coopChildRunning = false;
+	}
+	return s_coopChildRunning;
+}
+
+bool Sys_CoopStartChild( const char *args )
+{
+	char exe[MAX_OSPATH];
+	char dir[MAX_OSPATH];
+	char cmdLine[4096];
+
+	if ( Sys_CoopChildRunning() )
+	{
+		return true;	// player 2 is already up
+	}
+	if ( !GetModuleFileNameA( NULL, exe, sizeof( exe ) ) )
+	{
+		return false;
+	}
+	Q_strncpyz( dir, exe, sizeof( dir ) );
+	char *slash = strrchr( dir, '\\' );
+	if ( slash )
+	{
+		*slash = 0;
+	}
+	Com_sprintf( cmdLine, sizeof( cmdLine ), "\"%s\" %s", exe, args );
+
+	STARTUPINFOA si;
+	memset( &si, 0, sizeof( si ) );
+	si.cb = sizeof( si );
+	memset( &s_coopChild, 0, sizeof( s_coopChild ) );
+	if ( !CreateProcessA( exe, cmdLine, NULL, NULL, FALSE, 0, NULL, dir, &si, &s_coopChild ) )
+	{
+		Com_Printf( "Couldn't start player 2's game (error %lu)\n", GetLastError() );
+		return false;
+	}
+	s_coopChildRunning = true;
+	return true;
+}
+
+void Sys_CoopStopChild( void )
+{
+	if ( Sys_CoopChildRunning() )
+	{
+		TerminateProcess( s_coopChild.hProcess, 0 );
+		CloseHandle( s_coopChild.hProcess );
+		CloseHandle( s_coopChild.hThread );
