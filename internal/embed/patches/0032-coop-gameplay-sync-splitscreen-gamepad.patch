+/*
+==============
+jk2coop round 31 (joiner only): campaign state, the host's cutscene, AT-ST
+and remote views. The host sends them (g_main.cpp G_CoopCampaignSync /
+G_CoopCutsceneSync / G_CoopViewKindSync); here they are copied into the
+same variables the host's own game uses, so the stock datapad, letterbox,
+HUD and view code draw them unchanged.
+==============
+*/
+objectives_t	g_coopObjectives[MAX_MISSION_OBJ];	// cg_info.cpp reads these on a joiner
+extern int		statusTextIndex;
+static char		s_coopStateSeen[MAX_STRING_CHARS];
+static int		s_coopCamEnt = -1;
+static qboolean	s_coopCamOn = qfalse;
+static int		s_coopAtst[MAX_CLIENTS];
+static int		s_coopAtstClass[MAX_CLIENTS];
+static qboolean	s_coopAtstCam = qfalse;
+static int		s_coopViewEnt = 0;
+static qboolean	s_coopViewFov = qfalse;
+
+void CG_CoopRemoteReset( void )
+{
+	s_coopStateSeen[0] = 0;
+	s_coopCamEnt = -1;
+	s_coopCamOn = qfalse;
+	for ( int i = 0; i < MAX_CLIENTS; i++ )
+	{
+		s_coopAtst[i] = -1;
+	}
+	s_coopAtstCam = qfalse;
+	s_coopViewEnt = 0;
+	s_coopViewFov = qfalse;
+	memset( g_coopObjectives, 0, sizeof( g_coopObjectives ) );
+}
+
+static void CG_CoopCampaignFrame( void )
+{
+	const char *cs = CG_ConfigString( CS_COOP_STATE );
+	if ( !cs || !strcmp( cs, s_coopStateSeen ) )
+	{
+		return;
+	}
+	Q_strncpyz( s_coopStateSeen, cs, sizeof( s_coopStateSeen ) );
+
+	const char *o = Info_ValueForKey( cs, "o" );
+	qboolean updated = qfalse;
+	for ( int i = 0; i < MAX_MISSION_OBJ; i++ )
+	{
+		const int v = ( o[0] && i < (int)strlen( o ) ) ? ( o[i] - '0' ) & 7 : 0;
+		const int display = ( v & 4 ) ? OBJECTIVE_SHOW : OBJECTIVE_HIDE;
+		const int status = v & 3;
+		if ( display && ( !g_coopObjectives[i].display || g_coopObjectives[i].status != status ) )
+		{
+			updated = qtrue;
+		}
+		g_coopObjectives[i].display = display;
+		g_coopObjectives[i].status = status;
+	}
+	if ( updated )
+	{// the "datapad updated" flash, like the host's
+		missionInfo_Updated = qtrue;
+		cgi_Cvar_Set( "cg_updatedDataPadObjective", "1" );
+	}
+	const char *mf = Info_ValueForKey( cs, "mf" );
+	if ( mf[0] )
+	{
+		statusTextIndex = atoi( mf );
+	}
+	cg.missionStatusShow = (qboolean)( atoi( Info_ValueForKey( cs, "ms" ) ) != 0 );
+	const char *cam = Info_ValueForKey( cs, "cam" );
+	s_coopCamEnt = cam[0] ? atoi( cam ) : -1;
+}
+
+// the host's cutscene camera entity if it is in the current snapshot
+static centity_t *CG_CoopCutsceneCam( void )
+{
+	if ( s_coopCamEnt <= 0 || s_coopCamEnt >= ENTITYNUM_WORLD )
+	{
+		return NULL;
+	}
+	for ( int k = 0; k < cg.snap->numEntities; k++ )
+	{
+		if ( cg.snap->entities[k].number == s_coopCamEnt )
+		{
+			centity_t *cc = &cg_entities[s_coopCamEnt];
+			return ( cc->currentState.eType == ET_INVISIBLE ) ? cc : NULL;
+		}
+	}
+	return NULL;
+}
+
+static void CG_CoopCutsceneFrame( void )
+{
+	centity_t *cc = CG_CoopCutsceneCam();
+	if ( !cc )
+	{
+		if ( s_coopCamOn )
+		{// the host's cutscene is over: back to our own view
+			in_camera = false;
+			client_camera.info_state = 0;
+			client_camera.bar_alpha = client_camera.bar_alpha_source = client_camera.bar_alpha_dest = 0.0f;
+			client_camera.bar_height = client_camera.bar_height_source = client_camera.bar_height_dest = 0.0f;
+			client_camera.fade_color[3] = 0.0f;
+			s_coopCamOn = qfalse;
+		}
+		return;
+	}
+	const entityState_t *es = &cc->currentState;
+	s_coopCamOn = qtrue;
+	in_camera = ( es->time != 0 );
+	client_camera.info_state = 0;	// no moves/pans/fades of our own: the host's values each frame
+	client_camera.bar_time = cg.time - (int)( BAR_DURATION * 2 );	// CGCam_UpdateBarFade then just keeps the values
+	client_camera.bar_alpha = client_camera.bar_alpha_source = client_camera.bar_alpha_dest = es->angles2[1];
+	client_camera.bar_height = client_camera.bar_height_source = client_camera.bar_height_dest = es->angles2[2];
+	client_camera.fade_color[0] = es->origin2[0];
+	client_camera.fade_color[1] = es->origin2[1];
+	client_camera.fade_color[2] = es->origin2[2];
+	client_camera.fade_color[3] = es->time2 / 1000.0f;
+	if ( !in_camera )
+	{
+		return;
+	}
+	// smooth between the host's frames the same way entities are
+	vec3_t org, ang;
+	VectorCopy( es->pos.trBase, org );
+	VectorCopy( es->apos.trBase, ang );
+	if ( cc->interpolate && cg.nextSnap && cg.nextSnap->serverTime > cg.snap->serverTime )
+	{
+		float f = (float)( cg.time - cg.snap->serverTime ) / (float)( cg.nextSnap->serverTime - cg.snap->serverTime );
+		if ( f < 0.0f ) f = 0.0f;
+		if ( f > 1.0f ) f = 1.0f;
+		for ( int i = 0; i < 3; i++ )
+		{
+			org[i] = es->pos.trBase[i] + f * ( cc->nextState.pos.trBase[i] - es->pos.trBase[i] );
+			ang[i] = LerpAngle( es->apos.trBase[i], cc->nextState.apos.trBase[i], f );
+		}
+	}
+	VectorCopy( org, client_camera.origin );
+	VectorCopy( ang, client_camera.angles );
+	client_camera.FOV = client_camera.FOV2 = ( es->angles2[0] > 1.0f ) ? es->angles2[0] : CAMERA_DEFAULT_FOV;
+}
+
+// a player in an AT-ST is drawn as the AT-ST (the host rebuilds that player's
+// model in G_DriveATST; our copies of the players never got it)
+extern vmCvar_t cg_thirdPersonAlpha;
+static void CG_CoopATSTFrame( void )
+{
+	const int local = cg.snap->ps.clientNum;
+	for ( int i = 0; i < MAX_CLIENTS; i++ )
+	{
+		gentity_t *pent = &g_entities[i];
+		const char *pcs = CG_ConfigString( CS_PLAYERS + i );
+		if ( !pent->client || !pcs[0] )
+		{
+			s_coopAtst[i] = -1;
+			continue;
+		}
+		const int eflags = ( i == local ) ? cg.snap->ps.eFlags : cg_entities[i].currentState.eFlags;
+		const int in = ( eflags & EF_IN_ATST ) ? 1 : 0;
+		if ( s_coopAtst[i] == in || ( s_coopAtst[i] == -1 && !in ) )
+		{
+			s_coopAtst[i] = in;
+			continue;
+		}
+		if ( in )
+		{
+			s_coopAtstClass[i] = pent->client->NPC_class;
+		}
+		s_coopAtst[i] = in;
+		if ( pent->ghoul2.IsValid() )
+		{
+			gi.G2API_CleanGhoul2Models( pent->ghoul2 );
+		}
+		pent->playerModel = -1;
+		pent->weaponModel = -1;
+		pent->client->NPC_class = in ? CLASS_ATST : (class_t)s_coopAtstClass[i];
+		const char *model = in ? "atst" : Info_ValueForKey( pcs, "model" );
+		if ( !model[0] )
+		{
+			model = "kyle";
+		}
+		extern void G_SetG2PlayerModel( gentity_t * const ent, const char *modelName,
+			const char *customSkin, const char *surfOff, const char *surfOn );
+		G_SetG2PlayerModel( pent, model, NULL, NULL, NULL );
+		pent->client->ps.legsAnim = pent->client->ps.torsoAnim = -1;	// re-apply animation...
+		pent->client->ps.weapon = -1;									// ...and the held weapon
+	}
+
+	// round 34: our own guns in an AT-ST. The host's "coopweapon" command can
+	// arrive before the snapshot that gives us them, so keep at it until the
+	// AT-ST guns are selected; and back to a normal weapon when we get out.
+	extern void CG_ChangeWeapon( int num );
+	if ( cg.snap->ps.eFlags & EF_IN_ATST )
+	{
+		if ( cg.weaponSelect != WP_ATST_MAIN && cg.weaponSelect != WP_ATST_SIDE )
+		{
+			CG_ChangeWeapon( WP_ATST_MAIN );
+		}
+	}
+	else if ( cg.weaponSelect == WP_ATST_MAIN || cg.weaponSelect == WP_ATST_SIDE )
+	{
+		CG_ChangeWeapon( WP_BRYAR_PISTOL );
+		if ( cg.weaponSelect == WP_ATST_MAIN || cg.weaponSelect == WP_ATST_SIDE )
+		{
+			CG_ChangeWeapon( WP_SABER );
+		}
+		if ( cg.weaponSelect == WP_ATST_MAIN || cg.weaponSelect == WP_ATST_SIDE )
+		{
+			CG_ChangeWeapon( WP_NONE );
+		}
+	}
+
+	// our own camera in an AT-ST (the host's game does this for itself in ClientThink_real)
+	if ( cg.snap->ps.eFlags & EF_IN_ATST )
+	{
+		const float pitch = cg.snap->ps.viewangles[PITCH];
+		cg.overrides.active |= ( CG_OVERRIDE_3RD_PERSON_RNG | CG_OVERRIDE_3RD_PERSON_POF | CG_OVERRIDE_3RD_PERSON_VOF );
+		cg.overrides.thirdPersonRange = 240;
+		if ( pitch > 0 )
+		{
+			cg.overrides.thirdPersonPitchOffset = pitch * -0.75f;
+			cg.overrides.thirdPersonVertOffset = 300 + pitch * -10;
+			if ( cg.overrides.thirdPersonVertOffset < 0 )
+			{
+				cg.overrides.thirdPersonVertOffset = 0;
+			}
+		}
+		else if ( pitch < 0 )
+		{
+			cg.overrides.thirdPersonPitchOffset = pitch * -0.75f;
+			cg.overrides.thirdPersonVertOffset = 300 + pitch * -5;
+			if ( cg.overrides.thirdPersonVertOffset > 300 )
+			{
+				cg.overrides.thirdPersonVertOffset = 300;
+			}
+		}
+		else
+		{
+			cg.overrides.thirdPersonPitchOffset = 0;
+			cg.overrides.thirdPersonVertOffset = 200;
+		}
+		s_coopAtstCam = qtrue;
+	}
+	else if ( s_coopAtstCam )
+	{
+		cg.overrides.active &= ~( CG_OVERRIDE_3RD_PERSON_RNG | CG_OVERRIDE_3RD_PERSON_VOF | CG_OVERRIDE_3RD_PERSON_POF | CG_OVERRIDE_3RD_PERSON_APH );
+		cg.overrides.thirdPersonRange = cg.overrides.thirdPersonVertOffset = cg.overrides.thirdPersonPitchOffset = 0;
+		cg.overrides.thirdPersonAlpha = cg_thirdPersonAlpha.value;
+		s_coopAtstCam = qfalse;
+	}
+}
+
+// what we look through: our copies of cameras / turrets / droids have no
+// class name, health or NPC stats, which the view and HUD code ask for
+static void CG_CoopViewKindFrame( void )
+{
+	const int ve = cg.snap->ps.viewEntity;
+	const int kind = cg.snap->ps.stats[STAT_COOP_VIEWKIND];
+	if ( s_coopViewEnt && s_coopViewEnt != ve )
+	{
+		gentity_t *old = &g_entities[s_coopViewEnt];
+		old->classname = NULL;
+		old->e_DieFunc = dieF_NULL;
+		s_coopViewEnt = 0;
+	}
+	qboolean wantFov = qfalse;
+	if ( ve > 0 && ve < ENTITYNUM_WORLD && kind )
+	{
+		gentity_t *v = &g_entities[ve];
+		switch ( kind & 0xff )
+		{
+		case COOP_VIEW_CAMERA:
+		case COOP_VIEW_CAMERA_DEAD:
+			v->classname = (char *)"misc_camera";
+			v->e_DieFunc = dieF_camera_die;
+			v->health = ( ( kind & 0xff ) == COOP_VIEW_CAMERA ) ? 1 : 0;
+			break;
+		case COOP_VIEW_PANEL_TURRET:
+			v->classname = (char *)"misc_panel_turret";
+			v->s.weapon = WP_TURRET;	// CG_CalcViewValues: a fixed camera, no third-person offset
+			cg.overrides.fov = 50;
+			wantFov = qtrue;
+			break;
+		case COOP_VIEW_NPC:
+			cg.overrides.fov = ( kind >> 8 ) & 0xff;
+			wantFov = qtrue;
+			break;
+		default:
+			break;
+		}
+		s_coopViewEnt = ve;
+	}
+	if ( wantFov )
+	{
+		cg.overrides.active |= CG_OVERRIDE_FOV;
+		s_coopViewFov = qtrue;
+	}
+	else if ( s_coopViewFov )
+	{
+		cg.overrides.active &= ~CG_OVERRIDE_FOV;
+		cg.overrides.fov = 0;
+		s_coopViewFov = qfalse;
+	}
+}
