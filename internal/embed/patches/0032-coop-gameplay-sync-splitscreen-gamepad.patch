+/*
+===============
+CG_RemoteSyncPlaceholder
+
+jk2coop (remote client only): keep the joiner's local placeholder gentity for a
+non-player entity slot in step with what the host actually has in that slot.
+
+On a joiner, cent->gent is never spawned by game code -- the various M3 fixes
+build pieces of it (Ghoul2 models, a client struct for NPCs) the first time an
+entity is seen and then never touch it again. Two problems followed:
+
+1. Slot reuse. The host frees an entity slot (an NPC corpse fading out, a bolt
+   hitting a wall) and G_Spawn reuses that number for something else. The
+   joiner's placeholder still carried the OLD thing's Ghoul2 model, so a new
+   blaster bolt in a dead stormtrooper's old slot was drawn as the dead
+   stormtrooper ("the dead NPC's model flashes where I'm aiming when I shoot"),
+   and a new NPC in an old NPC slot kept the old NPC's body. Fix: remember what
+   each slot held (entity type + model index); when that changes, throw away
+   the placeholder's Ghoul2 model and reset its animation/weapon trackers so the
+   normal rebuild paths (CG_RemoteNPCModel, CG_Item, below) start fresh.
+
+2. World objects with Ghoul2 models (misc_turret, PAS sentries, some
+   misc_model_breakables, emplaced guns, ...). Their model is built only by the
+   host's spawn function (e.g. SP_misc_turret: gi.G2API_InitGhoul2Model), which
+   never runs on a joiner, so CG_General handed the renderer an empty model and
+   the object was simply missing ("the big turret isn't there for the joiner").
+   Fix: build the same model here from the model path the host already
+   networks in the CS_MODELS configstring for s.modelindex -- the same idea
+   JACoop uses (CG_CoopEnsureG2Model), and the same one-shot rebuild already
+   proven for dropped items in CG_Item.
+
+Player slots (< MAX_CLIENTS) are left alone: their model comes from CS_PLAYERS
+via CG_NewClientInfo. No-op on the host.
+===============
+*/
+static int	s_remoteSlotKey[MAX_GENTITIES];
+// jk2coop round 11: snapshot time each slot was last seen. Replaces round 10's
+// "forget on every CG_ResetEntity" (that fired whenever an entity missed a
+// single snapshot, rebuilding characters far more often than needed).
+static int	s_remoteSlotSeen[MAX_GENTITIES];
+extern int	g_coopAnimRebuilds;
+
+static void CG_RemoteResetPlaceholder( gentity_t *gent )
+{
+	if ( gent->ghoul2.IsValid() )
+	{
+		gi.G2API_CleanGhoul2Models( gent->ghoul2 );
+		g_coopAnimRebuilds++;
+	}
+	gent->playerModel = -1;
+	gent->weaponModel = -1;
+	if ( gent->client )
+	{
+		// force CG_RemoteDriveGhoul2Anim / CG_RemoteAttachWeaponModel to
+		// re-apply everything on the rebuilt model
+		gent->client->ps.legsAnim = -1;
+		gent->client->ps.torsoAnim = -1;
+		gent->client->ps.weapon = -1;
+	}
+}
+
+/*
+jk2coop round 12: turrets aim their barrel with Ghoul2 bone angles that only
+the host's copy of the model gets (g_turret.cpp turret_aim / pas_think). The
+host now sends those angles in s.angles2; put them on the joiner's model the
+same way, with the same 100 ms smoothing the host uses.
+*/
+static void CG_RemoteTurretBones( centity_t *cent, gentity_t *gent, const char *modelName )
+{
+	if ( gent->playerModel < 0 || gent->playerModel >= gent->ghoul2.size() )
+	{
+		return;
+	}
+	const entityState_t	*s = &cent->currentState;
+	CGhoul2Info			*g2 = &gent->ghoul2[gent->playerModel];
+	vec3_t				ang;
+
+	if ( !Q_stricmp( modelName, "models/map_objects/imp_mine/turret_canon.glm" )
+		|| !Q_stricmp( modelName, "models/map_objects/nar_shaddar/turret/turret.glm" ) )
+	{// misc_turret / misc_ns_turret: barrel pitch on Bone_body
+		VectorSet( ang, s->angles2[PITCH], 0.0f, 0.0f );
+		gi.G2API_SetBoneAngles( g2, "Bone_body", ang,
+			BONE_ANGLES_POSTMULT, POSITIVE_Y, POSITIVE_Z, POSITIVE_X, NULL, 100, cg.time );
+	}
+	else if ( !Q_stricmp( modelName, "models/items/psgun.glm" ) )
+	{// portable sentry: pitch on barrel + gback, turn on hinge
+		VectorSet( ang, s->angles2[PITCH], 0.0f, 0.0f );
+		gi.G2API_SetBoneAngles( g2, "bone_barrel", ang,
+			BONE_ANGLES_POSTMULT, POSITIVE_Y, POSITIVE_Z, NEGATIVE_X, NULL, 100, cg.time );
+		gi.G2API_SetBoneAngles( g2, "bone_gback", ang,
+			BONE_ANGLES_POSTMULT, POSITIVE_Y, POSITIVE_Z, NEGATIVE_X, NULL, 100, cg.time );
+		VectorSet( ang, 0.0f, 0.0f, s->angles2[ROLL] );
+		gi.G2API_SetBoneAngles( g2, "bone_hinge", ang,
+			BONE_ANGLES_POSTMULT, POSITIVE_Y, POSITIVE_Z, POSITIVE_X, NULL, 100, cg.time );
+	}
+}
+
+static void CG_RemoteSyncPlaceholder( centity_t *cent )
+{
+	const entityState_t	*s = &cent->currentState;
+	const int			num = s->number;
+	gentity_t			*gent = cent->gent;
+
+	if ( !cg_remoteClient || !gent || num < MAX_CLIENTS || num >= ENTITYNUM_WORLD )
+	{
+		return;
+	}
+
+	// what this slot holds right now (never 0; 0 = not seen since cgame init)
+	const int key = ( ( s->eType + 1 ) << 16 ) | ( s->modelindex & 0xffff );
+
+	// Slot reuse with the same model (a new stormtrooper in a dead one's slot):
+	// the host never reuses a freed slot for at least a second (G_Spawn), so an
+	// entity that was missing from our snapshots for over a second and is back
+	// may be a different one -- start its placeholder fresh. A character that
+	// merely walked out of view and back also gets rebuilt, which is harmless.
+	const int seen = s_remoteSlotSeen[num];
+	s_remoteSlotSeen[num] = cg.snap->serverTime;
+	if ( seen && ( cg.snap->serverTime - seen > 1000 || cg.snap->serverTime < seen ) )
+	{
+		s_remoteSlotKey[num] = 0;
+	}
+
+	if ( s_remoteSlotKey[num] != key )
+	{
+		// also on first sight after a map change: whatever the placeholder
+		// still holds belongs to something else
+		CG_RemoteResetPlaceholder( gent );
+		s_remoteSlotKey[num] = key;
+	}
+
+	// jk2coop round 19: a thrown lightsaber is drawn from its owner's saber
+	// state (blade length, colour); the host links them with a pointer that
+	// never existed on the joiner, so only the hilt flew. The owner's number
+	// rides in otherEntityNum (WP_SaberInitBladeData).
+	if ( s->eType == ET_GENERAL && s->weapon == WP_SABER )
+	{
+		const int o = s->otherEntityNum;
+		gent->owner = ( o >= 0 && o < ENTITYNUM_WORLD && g_entities[o].client ) ? &g_entities[o] : NULL;
+	}
+
+	// jk2coop round 22: "being Force pushed/pulled" (the ripple drawn on the
+	// thing that's moved) is a host-only time; the host flags it in s.powerups
+	// (G_CoopForceFxSync). NPCs pick this up in CG_Player's joiner sync.
+	if ( !gent->client )
+	{
+		gent->forcePushTime = ( s->powerups & ( 1 << COOP_PWB_PUSHED ) ) ? cg.time + 100 : 0;
+	}
+
+	// generic Ghoul2 world objects (players/NPCs and items have their own paths)
+	if ( s->eType == ET_PLAYER || s->eType == ET_ITEM || s->eType >= ET_EVENTS )
+	{
+		return;
+	}
+	if ( s->solid == SOLID_BMODEL || s->modelindex <= 0 || s->modelindex >= MAX_MODELS )
+	{
+		return;
+	}
+	const char *name = CG_ConfigString( CS_MODELS + s->modelindex );
+	const int len = name ? (int)strlen( name ) : 0;
+	if ( len <= 4 || Q_stricmp( name + len - 4, ".glm" ) )
+	{
+		return;	// md3 / brush models render without a Ghoul2 instance
+	}
+	if ( !gent->ghoul2.IsValid() )
+	{
+		gent->playerModel = gi.G2API_InitGhoul2Model( gent->ghoul2, name, s->modelindex, NULL_HANDLE, NULL_HANDLE, 0, 0 );
+		if ( s->weapon == WP_SABER && gent->playerModel >= 0 )
+		{// jk2coop round 19: the blade is drawn from bolt 0 = the hilt's tip tag,
+		 // which the host adds when it throws the saber (WP_SaberLaunch)
+			gi.G2API_AddBolt( &gent->ghoul2[gent->playerModel], "*flash" );
+		}
+		if ( s->weapon == WP_EMPLACED_GUN && gent->playerModel >= 0 )
+		{// jk2coop round 15: the seat/muzzle tags and swivel bone the host's
+		 // SP_emplaced_gun sets up; the chair code (CG_Player) and the gun
+		 // camera (CG_RunEmplacedWeapon) need them to seat a gunner
+			gent->headBolt = gi.G2API_AddBolt( &gent->ghoul2[0], "*seat" );
+			gent->handLBolt = gi.G2API_AddBolt( &gent->ghoul2[0], "*flash01" );
