+/*
+=================
+UI_CoopAddMenuButtons
+
+jk2coop: the stock main menu and pause menu are retail files we don't ship or
+modify, so the CO-OP buttons are added to them after they load. The buttons
+are plain menu items kept in ui/coop_buttons.txt (zz-coop-ui.pk3):
+
+	addToMenu "mainMenu" { itemDef { ... } itemDef { ... } }
+
+Each block is parsed into the named menu exactly like an itemDef in a .menu
+file. A menu that already has the items (reload) or doesn't exist is skipped.
+=================
+*/
+extern menuDef_t	*Menus_FindByName( const char *p );
+extern void			Menu_Init( menuDef_t *menu );
+extern qboolean		Menu_Parse( char *inbuffer, menuDef_t *menu );
+extern void			Menu_PostParse( menuDef_t *menu );
+
+static void UI_CoopAddMenuButtons( void )
+{
+	char	*buffer;
+	char	*token;
+
+	if ( PC_StartParseSession( "ui/coop_buttons.txt", &buffer ) <= 0 )
+	{
+		return;	// co-op UI pak not installed
+	}
+	while ( 1 )
+	{
+		token = PC_ParseExt();
+		if ( !token || !*token )
+		{
+			break;
+		}
+		if ( Q_stricmp( token, "addToMenu" ) )
+		{
+			PC_ParseWarning( va( "coop_buttons: unexpected '%s'", token ) );
+			break;
+		}
+		token = PC_ParseExt();
+		if ( !token || !*token )
+		{
+			break;
+		}
+		menuDef_t	*menu = Menus_FindByName( token );
+		static menuDef_t	scratch;	// where blocks for absent / already-done menus go
+		if ( !menu || Menu_FindItemByName( menu, "coopbutton" ) )
+		{
+			Menu_Init( &scratch );
+			menu = &scratch;
+		}
+		if ( !Menu_Parse( buffer, menu ) )
+		{
+			break;
+		}
+		// place the new items on screen: an item's rect is relative to its menu
+		// and only turned into screen coordinates after parsing (without this
+		// the button sat at the menu's top-left corner and couldn't be clicked)
+		Menu_PostParse( menu );
+	}
+	PC_EndParseSession( buffer );
+}
+
