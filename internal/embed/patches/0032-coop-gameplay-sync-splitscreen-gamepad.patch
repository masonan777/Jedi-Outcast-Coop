+/*
+==================
+jk2coop: split screen from the Co-op menu (see sys_win32.cpp)
+==================
+*/
+static pid_t s_coopChild = 0;
+
+bool Sys_CoopChildRunning( void )
+{
+	if ( s_coopChild <= 0 )
+	{
+		return false;
+	}
+	int status;
+	if ( waitpid( s_coopChild, &status, WNOHANG ) == s_coopChild )
+	{
+		s_coopChild = 0;
+	}
+	return s_coopChild > 0;
+}
+
+bool Sys_CoopStartChild( const char *args )
+{
+	char exe[MAX_OSPATH];
+
+	if ( Sys_CoopChildRunning() )
+	{
+		return true;
+	}
+	ssize_t len = readlink( "/proc/self/exe", exe, sizeof( exe ) - 1 );
+	if ( len <= 0 )
+	{
+		return false;
+	}
+	exe[len] = 0;
+
+	// split the argument string the way the engine joins it ("quoted" parts)
+	static char	buf[4096];
+	char		*argv[128];
+	int			argc = 0;
+	Q_strncpyz( buf, args, sizeof( buf ) );
+	argv[argc++] = exe;
+	for ( char *p = buf; *p && argc < 127; )
+	{
+		while ( *p == ' ' ) p++;
+		if ( !*p ) break;
+		if ( *p == '"' )
+		{
+			argv[argc++] = ++p;
+			while ( *p && *p != '"' ) p++;
+		}
+		else
+		{
+			argv[argc++] = p;
+			while ( *p && *p != ' ' ) p++;
+		}
+		if ( *p ) *p++ = 0;
+	}
+	argv[argc] = NULL;
+
+	pid_t pid = fork();
+	if ( pid < 0 )
+	{
+		return false;
+	}
+	if ( pid == 0 )
+	{
+		execv( exe, argv );
+		_exit( 127 );
+	}
+	s_coopChild = pid;
+	return true;
+}
+
+void Sys_CoopStopChild( void )
+{
+	if ( Sys_CoopChildRunning() )
+	{
+		kill( s_coopChild, SIGTERM );
+		s_coopChild = 0;
+	}
+}
