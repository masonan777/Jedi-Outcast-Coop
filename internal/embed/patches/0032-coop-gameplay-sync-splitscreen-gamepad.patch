+			cg.overrides.fov, ( cg.overrides.active & CG_OVERRIDE_FOV ) ? "" : "(off)" );
+		CG_CoopTestResult( ok, d );
+	}
+	else if ( !Q_stricmp( t, "atst" ) )
+	{
+		const int want = atoi( s_coopTest.arg[0] );
+		gentity_t *me = &g_entities[cg.snap->ps.clientNum];
+		const qboolean isAtst = (qboolean)( me->client && me->client->NPC_class == CLASS_ATST );
+		qboolean ok;
+		if ( want )
